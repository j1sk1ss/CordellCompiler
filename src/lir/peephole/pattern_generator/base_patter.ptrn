; ==================
; Jump cleanup
; ==================

jmp label_1
mklb label_1
->
mklb label_1
/

; ==================
; MOV and copy propagation
; ==================

setl areg_1
movsx areg_2, areg_1
test areg_2, areg_2
->
setl areg_1
test areg_1, areg_1
/

mov areg_1, obj_2
mov areg_3, areg_1
mov areg_1, obj_4
->
mov areg_3, obj_2
mov areg_1, obj_4
/

mov areg_1, areg_2
test areg_1, areg_1
->
test areg_2, areg_2
/

mov areg_1, areg_2
sub areg_1, obj_2
mov obj_1, areg_1
mov areg_2, areg_1
->
sub areg_2, obj_2
mov obj_1, areg_1
/

mov obj_1, obj_2 [if:equals]
->
delete
/

mov areg_1, const 0
->
xor areg_1, areg_1
/

mov areg_1, obj_2
mov obj_2, areg_1
->
mov areg_1, obj_2
/

mov areg_1, areg_2
cmp areg_1, obj_3
->
cmp areg_2, obj_3
/

xor areg_1, areg_1
mov areg_2, areg_1
->
xor areg_1, areg_1
xor areg_2, areg_2
/

mov areg_1, const 0
cmp areg_1, const 0
->
xor areg_1, areg_1
/

mov areg_1, const 0
test areg_1, areg_1
->
xor areg_1, areg_1
/

; ==================
; Arithmetic identities
; ==================

mov areg_1, aconst_2
mov areg_3, aconst_4
add areg_1, areg_3
->
mov areg_1, aconst_2
mov areg_3, aconst_4
add areg_1, aconst_4
/

mov areg_1, aconst_2
mov areg_3, aconst_4
sub areg_1, areg_3
->
mov areg_1, aconst_2
mov areg_3, aconst_4
sub areg_1, aconst_4
/

mov areg_1, const 1
mul areg_1, aconst_2
->
mov areg_1, aconst_2
/

mov areg_1, areg_2
add areg_1, areg_3
mov areg_2, areg_1
->
mov areg_1, areg_2
add areg_2, areg_3
/

add obj, const 0
->
delete
/

mov areg_1, areg_2
sub areg_1, const 1
mov areg_3, areg_1
->
sub areg_2, const 1
mov areg_3, areg_2
/

mov areg_2, areg_1
sub areg_2, const 1
mov areg_1, areg_2
->
mov areg_2, areg_1
sub areg_1, const 1
/

sub obj, const 0
->
delete
/

sub areg_1, areg_1
->
xor areg_1, areg_1
/

mul obj, const 0
->
mov obj, const 0
/

mul obj, const 1
->
delete
/

div obj, const 1
->
delete
/

; ==================
; Macro-fusion aware compare / branch canonicalization
; ==================

mov areg_1, areg_2
cmp areg_1, obj_3
base_jmpc obj_4
->
cmp areg_2, obj_3
base_jmpc obj_4
/

mov areg_1, areg_2
test areg_1, areg_1
base_jmpc obj_3
->
test areg_2, areg_2
base_jmpc obj_3
/

cmp areg_1, const 0
base_jmpc obj_2
->
test areg_1, areg_1
base_jmpc obj_2
/

or areg_1, areg_1
base_jmpc obj_2
->
test areg_1, areg_1
base_jmpc obj_2
/

and areg_1, areg_1
base_jmpc obj_2
->
test areg_1, areg_1
base_jmpc obj_2
/

sub areg_1, const 1
test areg_1, areg_1
je obj_2
->
sub areg_1, const 1
je obj_2
/

sub areg_1, const 1
test areg_1, areg_1
jz obj_2
->
sub areg_1, const 1
jz obj_2
/

sub areg_1, const 1
test areg_1, areg_1
jne obj_2
->
sub areg_1, const 1
jne obj_2
/

sub areg_1, const 1
test areg_1, areg_1
jnz obj_2
->
sub areg_1, const 1
jnz obj_2
/

sub areg_1, const 1
test areg_1, areg_1
sete obj_2
->
sub areg_1, const 1
sete obj_2
/

sub areg_1, const 1
test areg_1, areg_1
setne obj_2
->
sub areg_1, const 1
setne obj_2
/

; ==================
; Compare / test canonicalization
; ==================

cmp areg_1, const 0
->
test areg_1, areg_1
/

or areg_1, areg_1
->
test areg_1, areg_1
/

and areg_1, areg_1
->
test areg_1, areg_1
/

xor areg_1, areg_1
cmp areg_1, const 0
->
xor areg_1, areg_1
/

xor areg_1, areg_1
test areg_1, areg_1
->
xor areg_1, areg_1
/

; ==================
; Bitwise / shift simplifications
; ==================

and areg_1, const 0
->
xor areg_1, areg_1
/

shl obj, const 0
->
delete
/

shr obj, const 0
->
delete
/

not areg_1
not areg_1
->
delete
/

xor areg_1, areg_1
xor areg_1, areg_1
->
xor areg_1, areg_1
/

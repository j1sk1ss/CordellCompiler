function act_photo(ptr lis_game self) -> i0 {
    self.now.photos += 1;
    self.mood = ref "focused";
    resolve_scene(self, 2 as i32, 0 as i32, 1 as i32);
    draw_line(ref "Mira", ref "One photo. One tiny proof that time blinked.");
}

function act_talk(ptr lis_game self) -> i0 {
    self.mood = ref "kind";
    resolve_scene(self, 0 as i32, 3 as i32, 0 as i32);
    draw_line(ref "Lena", ref "Do not make this about destiny. Just stay with me.");
}

function act_search(ptr lis_game self) -> i0 {
    self.mood = ref "curious";
    resolve_scene(self, 1 as i32, 1 as i32, 0 as i32);
    draw_line(ref "Mira", ref "The clue was not hidden. I was looking from the wrong minute.");
}

function act_wait(ptr lis_game self) -> i0 {
    self.mood = ref "late";
    resolve_scene(self, 0 as i32, 0 as i32, 3 as i32);
    draw_line(ref "The sky answers first.");
}

:/ TODO: Implement send a flag to the builder /:
function act_rewind(ptr lis_game self) -> i0 {
#ifdef LIS_DEBUG_BREAKPOINTS 
    lis "rewind snapshot";
#endif
    self.rewind();
}

function read_command() -> i32 {
    i32 ch = getchar();
    i32 rest = ch;

    while rest != '\n' && rest != EOF; {
        rest = getchar();
    }

    return ch;
}

start() {
    lis_game game;
    game.new();
    intro_flash();

    while game.running; {
        game.draw();
        game.step(read_command());
    }

    if game.won;     draw_line(ref "\nEnding: the town gets one more sunrise.");
    if not game.won; draw_line(ref "\nEnding: rewind, retry, remember.");

    printf(ref "Final score: %i\n", game.score());
    game.destroy();

    if game.won; exit 0;
    exit 1;
}

#include "libc/stdlib_h.cpl"

container ll_node {
    ptr i0      val;
    ptr ll_node next;
    ptr ll_node prev;

    @[self]
    @[inline(model)]
    function init(ptr ll_node self, ptr i0 val) -> i0;

    @[inline(model)]
    function new(ptr i0 val) -> ptr ll_node;
}

container l_list {
    ptr ll_node head;
    ptr ll_node tail;

    @[self]
    function add(ptr l_list self, ptr i0 val) -> i0;

    @[self]
    function destroy(ptr l_list self) -> i0;
}

function ll_node::init(ptr ll_node self, ptr i0 val) -> i0 {
    self.val  = val;
    self.next = 0 as ptr ll_node;
    self.prev = 0 as ptr ll_node;
}

function ll_node::new(ptr i0 val) -> ptr ll_node {
    ptr ll_node nd = malloc(sizeof(ll_node));
    if not nd; return 0 as ptr ll_node;
    nd.init(val);
    nd;
}

function l_list::add(ptr l_list self, ptr i0 val) -> i0 {
    ptr ll_node nd = ll_node::new(val);
    if not nd; return;
    self.tail.next = nd;
    nd.prev = self.tail;
}

function l_list::destroy(ptr l_list self) -> i0 {
    ptr ll_node h = self.head;
    while h; {
        ptr ll_node nxt = h.next;
        free(h);
        h = nxt;
    }
}

@[entry("main")]
function main() -> u8 {
    l_list lst;
    lst.add(1 as ptr i0);
    lst.destroy();
    exit 0;
}
#include <raylib_h.cpl>

#define SCREEN_WIDTH  900
#define SCREEN_HEIGHT 540
#define MAX_ORBS      16

@[entry("main")]
start() {
    Color background;
    background = ray_color(242 as u8, 244 as u8, 238 as u8, 255 as u8);
    Color panel_top;
    panel_top = ray_color(41 as u8, 52 as u8, 60 as u8, 255 as u8);
    Color panel_bottom;
    panel_bottom = ray_color(28 as u8, 35 as u8, 42 as u8, 255 as u8);
    Color ink;
    ink = ray_color(246 as u8, 248 as u8, 239 as u8, 255 as u8);
    Color muted;
    muted = ray_color(174 as u8, 186 as u8, 177 as u8, 255 as u8);
    Color button_idle;
    button_idle = ray_color(238 as u8, 198 as u8, 67 as u8, 255 as u8);
    Color button_hot;
    button_hot = ray_color(255 as u8, 221 as u8, 91 as u8, 255 as u8);
    Color button_active;
    button_active = ray_color(225 as u8, 151 as u8, 59 as u8, 255 as u8);
    Color accent;
    accent = ray_color(35 as u8, 142 as u8, 121 as u8, 255 as u8);
    Color accent_hot;
    accent_hot = ray_color(53 as u8, 177 as u8, 151 as u8, 255 as u8);
    Color accent_active;
    accent_active = ray_color(20 as u8, 108 as u8, 93 as u8, 255 as u8);
    Color danger;
    danger = ray_color(198 as u8, 78 as u8, 67 as u8, 255 as u8);
    Color danger_hot;
    danger_hot = ray_color(224 as u8, 104 as u8, 91 as u8, 255 as u8);
    Color danger_active;
    danger_active = ray_color(156 as u8, 52 as u8, 47 as u8, 255 as u8);
    Color outline;
    outline = ray_color(25 as u8, 32 as u8, 38 as u8, 255 as u8);
    Color orb;
    orb = ray_color(69 as u8, 159 as u8, 203 as u8, 255 as u8);
    Color orb_ring;
    orb_ring = ray_color(24 as u8, 88 as u8, 117 as u8, 255 as u8);

    i32 add_x = 54;
    i32 pulse_x = 224;
    i32 speed_x = 414;
    i32 reset_x = 584;
    i32 button_y = 145;
    i32 button_w = 150;
    i32 button_h = 48;
    i32 pulse_w = 170;

    i32 orbs = 5;
    i32 clicks = 0;
    i32 speed = 2;
    i32 pulse = 1;
    i32 tick = 0;

    InitWindow(SCREEN_WIDTH as i32, SCREEN_HEIGHT as i32, ref "CPL raylib controls");
    SetTargetFPS(60 as i32);

    while not WindowShouldClose(); {
        tick += speed;

        i32 mouse_x = GetMouseX();
        i32 mouse_y = GetMouseY();
        i8 mouse_down = IsMouseButtonDown(MOUSE_BUTTON_LEFT as i32);
        i8 mouse_click = IsMouseButtonPressed(MOUSE_BUTTON_LEFT as i32);

        i32 add_hover = 0;
        i32 pulse_hover = 0;
        i32 speed_hover = 0;
        i32 reset_hover = 0;

        if mouse_x >= add_x && mouse_x <= add_x + button_w && mouse_y >= button_y && mouse_y <= button_y + button_h; {
            add_hover = 1;
        }
        if mouse_x >= pulse_x && mouse_x <= pulse_x + pulse_w && mouse_y >= button_y && mouse_y <= button_y + button_h; {
            pulse_hover = 1;
        }
        if mouse_x >= speed_x && mouse_x <= speed_x + button_w && mouse_y >= button_y && mouse_y <= button_y + button_h; {
            speed_hover = 1;
        }
        if mouse_x >= reset_x && mouse_x <= reset_x + button_w && mouse_y >= button_y && mouse_y <= button_y + button_h; {
            reset_hover = 1;
        }

        if mouse_click && add_hover; {
            if orbs < MAX_ORBS; {
                orbs += 1;
            }
            clicks += 1;
        }
        if mouse_click && pulse_hover; {
            if pulse; {
                pulse = 0;
            }
            else {
                pulse = 1;
            }
            clicks += 1;
        }
        if mouse_click && speed_hover; {
            speed += 1;
            if speed > 5; {
                speed = 1;
            }
            clicks += 1;
        }
        if mouse_click && reset_hover; {
            orbs = 5;
            speed = 2;
            pulse = 1;
            tick = 0;
            clicks += 1;
        }

        Color add_fill;
        add_fill = button_idle;
        if add_hover; {
            add_fill = button_hot;
        }
        if add_hover && mouse_down; {
            add_fill = button_active;
        }

        Color pulse_fill;
        pulse_fill = accent;
        if pulse_hover; {
            pulse_fill = accent_hot;
        }
        if pulse_hover && mouse_down; {
            pulse_fill = accent_active;
        }
        if not pulse; {
            pulse_fill = danger;
            if pulse_hover; {
                pulse_fill = danger_hot;
            }
            if pulse_hover && mouse_down; {
                pulse_fill = danger_active;
            }
        }

        Color speed_fill;
        speed_fill = button_idle;
        if speed_hover; {
            speed_fill = button_hot;
        }
        if speed_hover && mouse_down; {
            speed_fill = button_active;
        }

        Color reset_fill;
        reset_fill = danger;
        if reset_hover; {
            reset_fill = danger_hot;
        }
        if reset_hover && mouse_down; {
            reset_fill = danger_active;
        }

        BeginDrawing();
        ClearBackground(background);

        DrawRectangleGradientV(0 as i32, 0 as i32, SCREEN_WIDTH as i32, 230 as i32, panel_top, panel_bottom);
        DrawText(ref "CPL + raylib", 54 as i32, 36 as i32, 34 as i32, ink);
        DrawText(ref "mouse hover, clicks, animation, text formatting", 56 as i32, 78 as i32, 20 as i32, muted);
        DrawText(TextFormat(ref "orbs: %i   speed: %i   clicks: %i", orbs, speed, clicks), 56 as i32, 106 as i32, 18 as i32, muted);

        DrawRectangle(add_x, button_y, button_w, button_h, add_fill);
        DrawRectangleLines(add_x, button_y, button_w, button_h, outline);
        DrawText(ref "+ orb", add_x + 48, button_y + 14, 18 as i32, outline);

        DrawRectangle(pulse_x, button_y, pulse_w, button_h, pulse_fill);
        DrawRectangleLines(pulse_x, button_y, pulse_w, button_h, outline);
        if pulse; {
            DrawText(ref "pulse on", pulse_x + 45, button_y + 14, 18 as i32, ink);
        }
        else {
            DrawText(ref "pulse off", pulse_x + 39, button_y + 14, 18 as i32, ink);
        }

        DrawRectangle(speed_x, button_y, button_w, button_h, speed_fill);
        DrawRectangleLines(speed_x, button_y, button_w, button_h, outline);
        DrawText(ref "speed +", speed_x + 42, button_y + 14, 18 as i32, outline);

        DrawRectangle(reset_x, button_y, button_w, button_h, reset_fill);
        DrawRectangleLines(reset_x, button_y, button_w, button_h, outline);
        DrawText(ref "reset", reset_x + 52, button_y + 14, 18 as i32, ink);

        DrawText(ref "interactive draw loop", 54 as i32, 258 as i32, 24 as i32, outline);

        i32 marker_x = 54 + tick % 730;
        DrawRectangle(54 as i32, 292 as i32, 760 as i32, 8 as i32, muted);
        DrawRectangle(marker_x, 288 as i32, 48 as i32, 16 as i32, danger);

        i32 i = 0;
        while i < orbs; {
            i32 col = i % 8;
            i32 row = i / 8;
            i32 x = 118 + col * 88;
            i32 y = 322 + row * 78;
            i32 size = 34;

            if pulse; {
                size = size + (tick / 4 + i) % (4 + speed);
            }

            DrawRectangle(x - size / 2, y - size / 2, size, size, orb);
            DrawRectangleLines(x - size / 2, y - size / 2, size, size, orb_ring);
            DrawText(TextFormat(ref "%i", i + 1), x - 5, y - 8, 16 as i32, ink);
            i += 1;
        }

        DrawLine(mouse_x - 8, mouse_y, mouse_x + 8, mouse_y, danger);
        DrawLine(mouse_x, mouse_y - 8, mouse_x, mouse_y + 8, danger);
        DrawFPS(816 as i32, 18 as i32);

        EndDrawing();
    }

    CloseWindow();
    exit 0;
}

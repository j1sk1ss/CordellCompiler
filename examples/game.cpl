#include "game_h.cpl"

@[impl(game)]
function new(ptr game self) -> i0 {
    self.width   = 7;
    self.height  = 5;
    self.map     = strdup(ref "########...K.##.###.##...E.########");
    self.px      = 1;
    self.py      = 1;
    self.has_key = 0;
    self.running = 1;
    self.won     = 0;
}

@[impl(game)]
function index(ptr game self, i32 x, i32 y) -> i32 {
    y * self.width + x;
}

@[impl(game)]
function cell(ptr game self, i32 x, i32 y) -> ptr i8 {
    self.map + self.index(x, y) as ptr i8;
}

@[impl(game)]
function draw(ptr game self) -> i0 {
    i32 y = 0;

    while y < self.height; {
        i32 x = 0;

        while x < self.width; {
            i32 pos = self.index(x, y);
            i32 player_pos = self.index(self.px, self.py);
            i8 ch = dref (self.map + pos as ptr i8);
            if pos == player_pos; {
                ch = 64;
            }

            putchar(ch);
            x += 1;
        }

        putchar('\n');
        y += 1;
    }

    if self.has_key; puts(ref "Key: yes");
    if not self.has_key; puts(ref "Key: no");
    puts(ref "Move: w/a/s/d, quit: q");
}

@[impl(game)]
function step(ptr game self, i32 input) -> i0 {
    if input == 'q'; {
        self.running = 0;
        return;
    }

    i32 nx = self.px;
    i32 ny = self.py;

    @[no_fall]
    @[straight]
    switch input; {
        case 'w'; { ny -= 1; }
        case 's'; { ny += 1; }
        case 'a'; { nx -= 1; }
        case 'd'; { nx += 1; }
    }

    ptr i8 target_ptr = self.cell(nx, ny);
    i8 target = dref target_ptr;
    if target == '#'; {
        return;
    }

    if target == 'K'; {
        self.has_key = 1;
        dref target_ptr = '.';
    }

    if target == 'E'; {
        if self.has_key; {
            self.won = 1;
            self.running = 0;
            return;
        }

        puts(ref "Door is locked. Find the key!");
        return;
    }

    self.px = nx;
    self.py = ny;
}

@[impl(game)]
function destroy(ptr game self) -> i0 {
    free(self.map);
    self.map = 0 as ptr i8;
}

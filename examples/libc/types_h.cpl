#ifndef CPL_LIBC_TYPES_H_
#define CPL_LIBC_TYPES_H_ 0

#define NULL 0

@[like_c]
container cpl_file {
    i64 _opaque;
}

@[like_c]
container cpl_locale {
    i64 _opaque;
}

@[like_c]
container c_div {
    i32 quot;
    i32 rem;
}

@[like_c]
container c_ldiv {
    i64 quot;
    i64 rem;
}

@[like_c]
container c_lldiv {
    i64 quot;
    i64 rem;
}

@[like_c]
container c_tm {
    i32 tm_sec;
    i32 tm_min;
    i32 tm_hour;
    i32 tm_mday;
    i32 tm_mon;
    i32 tm_year;
    i32 tm_wday;
    i32 tm_yday;
    i32 tm_isdst;
}

@[like_c]
container c_lconv {
    ptr i8 decimal_point;
    ptr i8 thousands_sep;
    ptr i8 grouping;
    ptr i8 int_curr_symbol;
    ptr i8 currency_symbol;
    ptr i8 mon_decimal_point;
    ptr i8 mon_thousands_sep;
    ptr i8 mon_grouping;
    ptr i8 positive_sign;
    ptr i8 negative_sign;
    i8     int_frac_digits;
    i8     frac_digits;
    i8     p_cs_precedes;
    i8     p_sep_by_space;
    i8     n_cs_precedes;
    i8     n_sep_by_space;
    i8     p_sign_posn;
    i8     n_sign_posn;
}

#endif

#ifndef CPL_POLL_H_
#define CPL_POLL_H_ 0

#include "platform_h.cpl"
#include "stddef_h.cpl"

#define POLLIN   1
#define POLLPRI  2
#define POLLOUT  4
#define POLLERR  8
#define POLLHUP  16
#define POLLNVAL 32

:/ Describes one file descriptor monitored by poll.
- `fd`:[i32] - File descriptor to monitor.
- `events`:[i16] - Bit mask of events requested by the caller.
- `revents`:[i16] - Bit mask of events reported by the operating system.
/:
@[like_c]
container c_pollfd {
    i32 fd;
    i16 events;
    i16 revents;
}

:/ Waits for events on a set of file descriptors.
- `fds`:[ptr c_pollfd] - Pointer to the array of descriptors and requested events.
- `count`:[u64] - Number of elements, objects, descriptors, or bytes involved in the operation.
- `timeout`:[i32] - Maximum wait time in milliseconds, with a negative value meaning no timeout.

Returns the number of descriptors with reported events, zero on timeout, or -1 on failure:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_poll")] @[abi] extern function poll(ptr c_pollfd fds, u64 count, i32 timeout) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function poll(ptr c_pollfd fds, u64 count, i32 timeout) -> i32;
#endif

#endif

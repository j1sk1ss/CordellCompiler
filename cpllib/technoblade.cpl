#include "technoblade_h.cpl"

glob function technoblade::can_die() -> i8 { 0 }

glob function technoblade::get_summary() -> ptr i8 { ref "Technoblade never dies!" }

glob function technoblade::hello() -> i0 {
    if not technoblade::can_die();
        printf(ref "%s\n", technoblade::get_summary());
    else :/ Actually it's an unreacheble branch... /:
        printf(ref "You are fool! - %s\n", technoblade::get_summary());
}
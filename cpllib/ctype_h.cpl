:/ Converts an uppercase character to lowercase when possible.
- `c`:[i32] - Character value represented as an unsigned byte or end-of-file marker.

Returns the converted lowercase character, or the original character when no conversion exists:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_tolower")] @[abi] extern function tolower(i32 c) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function tolower(i32 c) -> i32;
#endif

:/ Converts a lowercase character to uppercase when possible.
- `c`:[i32] - Character value represented as an unsigned byte or end-of-file marker.

Returns the converted uppercase character, or the original character when no conversion exists:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_toupper")] @[abi] extern function toupper(i32 c) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function toupper(i32 c) -> i32;
#endif

#endif

#ifndef CCPL_MACHO64
@[abi] extern function ispunct(i32 c) -> i32;
#endif

:/ Checks whether a character is whitespace.
- `c`:[i32] - Character value represented as an unsigned byte or end-of-file marker.

Returns a nonzero value when the character satisfies the test, otherwise zero:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_isspace")] @[abi] extern function isspace(i32 c) -> i32;
#endif

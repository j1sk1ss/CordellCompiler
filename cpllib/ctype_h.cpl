#ifndef CPL_CTYPE_H_
#define CPL_CTYPE_H_ 0

#include "platform_h.cpl"

#define char     i8
#define uchar    u8
#define short    i16
#define ushort   u16
#define signed   i32
#define int      i32
#define uint     u32
#define unsigned u32
#define long     i64
#define ulong    u64
#define float    f32
#define double   f64

:/ Checks whether a character is alphanumeric.
- `c`:[i32] - Character value represented as an unsigned byte or end-of-file marker.

Returns a nonzero value when the character satisfies the test, otherwise zero:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_isalnum")] @[abi] extern function isalnum(i32 c) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function isalnum(i32 c) -> i32;
#endif

:/ Checks whether a character is alphabetic.
- `c`:[i32] - Character value represented as an unsigned byte or end-of-file marker.

Returns a nonzero value when the character satisfies the test, otherwise zero:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_isalpha")] @[abi] extern function isalpha(i32 c) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function isalpha(i32 c) -> i32;
#endif

:/ Checks whether a character is a blank character.
- `c`:[i32] - Character value represented as an unsigned byte or end-of-file marker.

Returns a nonzero value when the character satisfies the test, otherwise zero:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_isblank")] @[abi] extern function isblank(i32 c) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function isblank(i32 c) -> i32;
#endif

:/ Checks whether a character is a control character.
- `c`:[i32] - Character value represented as an unsigned byte or end-of-file marker.

Returns a nonzero value when the character satisfies the test, otherwise zero:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_iscntrl")] @[abi] extern function iscntrl(i32 c) -> i32;

#ifndef CPL_INTTYPES_H_
#define CPL_INTTYPES_H_ 0

#include "platform_h.cpl"
#include "stdint_h.cpl"

#define intmax_t  i64
#define uintmax_t u64

:/ Computes the absolute value of the widest signed integer type.
- `value`:[i64] - Input integer value.

Returns the absolute value:[i64]
/:
#ifdef CCPL_MACHO64
@[vname("_imaxabs")] @[abi] extern function imaxabs(i64 value) -> i64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function imaxabs(i64 value) -> i64;
#endif

:/ Converts a byte string to the widest signed integer type.
- `s`:[ptr i8] - Null-terminated byte string containing the integer representation.
- `endptr`:[ptr ptr i8] - Optional output pointer that receives the address of the first unparsed character.
- `base`:[i32] - Numeric base from 2 through 36, or zero to detect the base from the input prefix.

Returns the converted signed integer value:[i64]
/:
#ifdef CCPL_MACHO64
@[vname("_strtoimax")] @[abi] extern function strtoimax(ptr i8 s, ptr ptr i8 endptr, i32 base) -> i64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strtoimax(ptr i8 s, ptr ptr i8 endptr, i32 base) -> i64;
#endif

:/ Converts a byte string to the widest unsigned integer type.
- `s`:[ptr i8] - Null-terminated byte string containing the integer representation.
- `endptr`:[ptr ptr i8] - Optional output pointer that receives the address of the first unparsed character.
- `base`:[i32] - Numeric base from 2 through 36, or zero to detect the base from the input prefix.

Returns the converted unsigned integer value:[u64]
/:
#ifdef CCPL_MACHO64
@[vname("_strtoumax")] @[abi] extern function strtoumax(ptr i8 s, ptr ptr i8 endptr, i32 base) -> u64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strtoumax(ptr i8 s, ptr ptr i8 endptr, i32 base) -> u64;
#endif

#endif

#ifndef CPL_TIME_H_
#define CPL_TIME_H_ 0

#include "platform_h.cpl"
#include "stddef_h.cpl"
#include "types_h.cpl"

#define CLOCKS_PER_SEC                  1000000
#define CLOCK_REALTIME                  0
#ifdef CCPL_MACHO64
    #define CLOCK_MONOTONIC             6
    #define CLOCK_MONOTONIC_RAW         4
    #define CLOCK_UPTIME_RAW            8
#endif
#ifndef CCPL_MACHO64
    #define CLOCK_MONOTONIC             1
    #define CLOCK_PROCESS_CPUTIME_ID    2
    #define CLOCK_THREAD_CPUTIME_ID     3
#endif

:/ Returns processor time consumed by the program.

Returns the consumed processor time in implementation-defined clock ticks, or -1 when unavailable:[i64]
/:
#ifdef CCPL_MACHO64
@[vname("_clock")] @[abi] extern function clock() -> i64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function clock() -> i64;
#endif

:/ Returns the current calendar time.
- `timer`:[ptr i64] - Optional output pointer that receives the returned calendar time.

Returns the current calendar time, or -1 on failure:[i64]
/:
#ifdef CCPL_MACHO64
@[vname("_time")] @[abi] extern function time(ptr i64 timer) -> i64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function time(ptr i64 timer) -> i64;
#endif

:/ Computes the difference between two calendar times in seconds.
- `end_time`:[i64] - Later calendar time.
- `begin_time`:[i64] - Earlier calendar time.

Returns the elapsed time in seconds:[f64]
/:
#ifdef CCPL_MACHO64
@[vname("_difftime")] @[abi] extern function difftime(i64 end_time, i64 begin_time) -> f64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function difftime(i64 end_time, i64 begin_time) -> f64;
#endif

:/ Converts a broken-down local time to calendar time.
- `tm`:[ptr c_tm] - Broken-down local time to normalize and convert.

Returns the converted calendar time, or -1 when it cannot be represented:[i64]
/:
#ifdef CCPL_MACHO64
@[vname("_mktime")] @[abi] extern function mktime(ptr c_tm tm) -> i64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function mktime(ptr c_tm tm) -> i64;
#endif

:/ Converts a broken-down time to a textual representation.
- `tm`:[ptr c_tm] - Pointer to a broken-down time value.

Returns a pointer to a textual time representation:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_asctime")] @[abi] extern function asctime(ptr c_tm tm) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function asctime(ptr c_tm tm) -> ptr i8;
#endif

:/ Converts calendar time to a textual local-time representation.
- `timer`:[ptr i64] - Optional output pointer receiving calendar time, or pointer to input calendar time.

Returns a pointer to a textual local-time representation:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_ctime")] @[abi] extern function ctime(ptr i64 timer) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function ctime(ptr i64 timer) -> ptr i8;
#endif

:/ Converts calendar time to broken-down Coordinated Universal Time.
- `timer`:[ptr i64] - Optional output pointer receiving calendar time, or pointer to input calendar time.

Returns a pointer to broken-down UTC, or a null pointer on failure:[ptr c_tm]
/:
#ifdef CCPL_MACHO64
@[vname("_gmtime")] @[abi] extern function gmtime(ptr i64 timer) -> ptr c_tm;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function gmtime(ptr i64 timer) -> ptr c_tm;
#endif

:/ Converts calendar time to broken-down local time.
- `timer`:[ptr i64] - Optional output pointer receiving calendar time, or pointer to input calendar time.

Returns a pointer to broken-down local time, or a null pointer on failure:[ptr c_tm]
/:
#ifdef CCPL_MACHO64
@[vname("_localtime")] @[abi] extern function localtime(ptr i64 timer) -> ptr c_tm;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function localtime(ptr i64 timer) -> ptr c_tm;
#endif

:/ Formats a broken-down time according to a format string.
- `s`:[ptr i8] - Pointer to an input string or caller-provided output buffer.
- `max_size`:[u64] - Capacity of the output buffer in bytes.
- `format`:[ptr i8] - Null-terminated time-format string.
- `tm`:[ptr c_tm] - Pointer to a broken-down time value.

Returns the number of bytes written excluding the terminator, or zero when the buffer is insufficient:[u64]
/:
#ifdef CCPL_MACHO64
@[vname("_strftime")] @[abi] extern function strftime(ptr i8 s, u64 max_size, ptr i8 format, ptr c_tm tm) -> u64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strftime(ptr i8 s, u64 max_size, ptr i8 format, ptr c_tm tm) -> u64;
#endif

:/ Reads the current value of a specified clock.
- `clock_id`:[i32] - Identifier of the clock to query.
- `time`:[ptr c_timespec] - Output pointer that receives the current clock value.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_clock_gettime")] @[abi] extern function clock_gettime(i32 clock_id, ptr c_timespec time) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function clock_gettime(i32 clock_id, ptr c_timespec time) -> i32;
#endif

:/ Retrieves the resolution of a specified clock.
- `clock_id`:[i32] - Identifier of the clock to query.
- `resolution`:[ptr c_timespec] - Output pointer that receives the clock resolution.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_clock_getres")] @[abi] extern function clock_getres(i32 clock_id, ptr c_timespec resolution) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function clock_getres(i32 clock_id, ptr c_timespec resolution) -> i32;
#endif

:/ Suspends execution for at least the requested interval.
- `duration`:[ptr c_timespec] - Requested sleep interval.
- `remaining`:[ptr c_timespec] - Optional output pointer receiving the unslept interval after interruption.

Returns zero after the full interval, otherwise -1 when interrupted or failed:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_nanosleep")] @[abi] extern function nanosleep(ptr c_timespec duration, ptr c_timespec remaining) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function nanosleep(ptr c_timespec duration, ptr c_timespec remaining) -> i32;
#endif

#endif

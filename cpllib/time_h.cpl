#ifndef CPL_TIME_H_
#define CPL_TIME_H_ 0

#include "platform_h.cpl"
#include "stddef_h.cpl"
#include "types_h.cpl"

#define CLOCKS_PER_SEC 1000000
#define CLOCK_REALTIME  0
#ifdef CCPL_MACHO64
#define CLOCK_MONOTONIC 6
#define CLOCK_MONOTONIC_RAW 4
#define CLOCK_UPTIME_RAW 8
#endif
#ifndef CCPL_MACHO64
#define CLOCK_MONOTONIC 1
#define CLOCK_PROCESS_CPUTIME_ID 2
#define CLOCK_THREAD_CPUTIME_ID 3
#endif

#ifdef CCPL_MACHO64
@[vname("_clock")] @[abi] extern function clock() -> i64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function clock() -> i64;
#endif
#ifdef CCPL_MACHO64
@[vname("_time")] @[abi] extern function time(ptr i64 timer) -> i64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function time(ptr i64 timer) -> i64;
#endif
#ifdef CCPL_MACHO64
@[vname("_difftime")] @[abi] extern function difftime(i64 end_time, i64 begin_time) -> f64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function difftime(i64 end_time, i64 begin_time) -> f64;
#endif
#ifdef CCPL_MACHO64
@[vname("_mktime")] @[abi] extern function mktime(ptr c_tm tm) -> i64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function mktime(ptr c_tm tm) -> i64;
#endif
#ifdef CCPL_MACHO64
@[vname("_asctime")] @[abi] extern function asctime(ptr c_tm tm) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function asctime(ptr c_tm tm) -> ptr i8;
#endif
#ifdef CCPL_MACHO64
@[vname("_ctime")] @[abi] extern function ctime(ptr i64 timer) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function ctime(ptr i64 timer) -> ptr i8;
#endif
#ifdef CCPL_MACHO64
@[vname("_gmtime")] @[abi] extern function gmtime(ptr i64 timer) -> ptr c_tm;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function gmtime(ptr i64 timer) -> ptr c_tm;
#endif
#ifdef CCPL_MACHO64
@[vname("_localtime")] @[abi] extern function localtime(ptr i64 timer) -> ptr c_tm;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function localtime(ptr i64 timer) -> ptr c_tm;
#endif
#ifdef CCPL_MACHO64
@[vname("_strftime")] @[abi] extern function strftime(ptr i8 s, u64 max_size, ptr i8 format, ptr c_tm tm) -> u64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strftime(ptr i8 s, u64 max_size, ptr i8 format, ptr c_tm tm) -> u64;
#endif
#ifdef CCPL_MACHO64
@[vname("_clock_gettime")] @[abi] extern function clock_gettime(i32 clock_id, ptr c_timespec time) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function clock_gettime(i32 clock_id, ptr c_timespec time) -> i32;
#endif
#ifdef CCPL_MACHO64
@[vname("_clock_getres")] @[abi] extern function clock_getres(i32 clock_id, ptr c_timespec resolution) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function clock_getres(i32 clock_id, ptr c_timespec resolution) -> i32;
#endif
#ifdef CCPL_MACHO64
@[vname("_nanosleep")] @[abi] extern function nanosleep(ptr c_timespec duration, ptr c_timespec remaining) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function nanosleep(ptr c_timespec duration, ptr c_timespec remaining) -> i32;
#endif

#endif

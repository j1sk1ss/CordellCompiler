#ifndef CPL_STRING_H_
#define CPL_STRING_H_ 0

#include "platform_h.cpl"
#include "stddef_h.cpl"

:/ Copies a fixed number of bytes between non-overlapping memory regions.
- `dst`:[ptr i0] - Pointer to the destination memory region or string.
- `src`:[ptr i0] - Pointer to the source memory region or string.
- `n`:[u64] - Maximum number of bytes or characters to process.

Returns the destination pointer:[ptr i0]
/:
#ifdef CCPL_MACHO64
@[vname("_memcpy")] @[abi] extern function memcpy(ptr i0 dst, ptr i0 src, u64 n) -> ptr i0;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function memcpy(ptr i0 dst, ptr i0 src, u64 n) -> ptr i0;
#endif

:/ Copies a fixed number of bytes between possibly overlapping memory regions.
- `dst`:[ptr i0] - Pointer to the destination memory region or string.
- `src`:[ptr i0] - Pointer to the source memory region or string.
- `n`:[u64] - Maximum number of bytes or characters to process.

Returns the destination pointer:[ptr i0]
/:
#ifdef CCPL_MACHO64
@[vname("_memmove")] @[abi] extern function memmove(ptr i0 dst, ptr i0 src, u64 n) -> ptr i0;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function memmove(ptr i0 dst, ptr i0 src, u64 n) -> ptr i0;
#endif

:/ Fills a memory region with a repeated byte value.
- `s`:[ptr i0] - Pointer to the memory region to fill.
- `c`:[i32] - Byte value used to fill the destination region.
- `n`:[u64] - Maximum number of bytes or characters to process.

Returns the destination pointer:[ptr i0]
/:
#ifdef CCPL_MACHO64
@[vname("_memset")] @[abi] extern function memset(ptr i0 s, i32 c, u64 n) -> ptr i0;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function memset(ptr i0 s, i32 c, u64 n) -> ptr i0;
#endif

:/ Compares two memory regions byte by byte.
- `a`:[ptr i0] - Pointer to the first value, string, or memory region.
- `b`:[ptr i0] - Pointer to the second value, string, or memory region.
- `n`:[u64] - Maximum number of bytes or characters to process.

Returns a value less than, equal to, or greater than zero according to lexical byte ordering:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_memcmp")] @[abi] extern function memcmp(ptr i0 a, ptr i0 b, u64 n) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function memcmp(ptr i0 a, ptr i0 b, u64 n) -> i32;
#endif

:/ Searches a memory region for the first occurrence of a byte value.
- `s`:[ptr i0] - Pointer to the memory region to search.
- `c`:[i32] - Byte value to locate.
- `n`:[u64] - Maximum number of bytes or characters to process.

Returns a pointer to the matching byte, or a null pointer when not found:[ptr i0]
/:
#ifdef CCPL_MACHO64
@[vname("_memchr")] @[abi] extern function memchr(ptr i0 s, i32 c, u64 n) -> ptr i0;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function memchr(ptr i0 s, i32 c, u64 n) -> ptr i0;
#endif

:/ Returns the length of the byte sequence owned by a string object.
- `s`:[ptr i8] - Null-terminated byte string to inspect.

Returns the number of bytes before the terminating null byte:[u64]
/:
#ifdef CCPL_MACHO64
@[vname("_strlen")] @[abi] extern function strlen(ptr i8 s) -> u64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strlen(ptr i8 s) -> u64;
#endif

:/ Returns the length of a byte string up to a specified limit.
- `s`:[ptr i8] - Byte string to inspect.
- `max_len`:[u64] - Maximum number of characters to inspect.

Returns the number of bytes before the terminator or the supplied limit, whichever comes first:[u64]
/:
#ifdef CCPL_MACHO64
@[vname("_strnlen")] @[abi] extern function strnlen(ptr i8 s, u64 max_len) -> u64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strnlen(ptr i8 s, u64 max_len) -> u64;
#endif

:/ Copies a null-terminated byte string.
- `dst`:[ptr i8] - Pointer to the destination memory region or string.
- `src`:[ptr i8] - Pointer to the source memory region or string.

Returns the destination pointer:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strcpy")] @[abi] extern function strcpy(ptr i8 dst, ptr i8 src) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strcpy(ptr i8 dst, ptr i8 src) -> ptr i8;
#endif

:/ Copies at most a specified number of bytes from a byte string.
- `dst`:[ptr i8] - Pointer to the destination memory region or string.
- `src`:[ptr i8] - Pointer to the source memory region or string.
- `n`:[u64] - Maximum number of bytes or characters to process.

Returns the destination pointer:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strncpy")] @[abi] extern function strncpy(ptr i8 dst, ptr i8 src, u64 n) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strncpy(ptr i8 dst, ptr i8 src, u64 n) -> ptr i8;
#endif

:/ Appends a null-terminated byte string to another byte string.
- `dst`:[ptr i8] - Pointer to the destination memory region or string.
- `src`:[ptr i8] - Pointer to the source memory region or string.

Returns the destination pointer:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strcat")] @[abi] extern function strcat(ptr i8 dst, ptr i8 src) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strcat(ptr i8 dst, ptr i8 src) -> ptr i8;
#endif

:/ Appends at most a specified number of bytes from one string to another.
- `dst`:[ptr i8] - Pointer to the destination memory region or string.
- `src`:[ptr i8] - Pointer to the source memory region or string.
- `n`:[u64] - Maximum number of bytes or characters to process.

Returns the destination pointer:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strncat")] @[abi] extern function strncat(ptr i8 dst, ptr i8 src, u64 n) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strncat(ptr i8 dst, ptr i8 src, u64 n) -> ptr i8;
#endif

:/ Compares two null-terminated byte strings lexicographically.
- `a`:[ptr i8] - Pointer to the first value, string, or memory region.
- `b`:[ptr i8] - Pointer to the second value, string, or memory region.

Returns a value less than, equal to, or greater than zero according to lexical ordering:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_strcmp")] @[abi] extern function strcmp(ptr i8 a, ptr i8 b) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strcmp(ptr i8 a, ptr i8 b) -> i32;
#endif

:/ Compares at most a specified number of bytes from two strings.
- `a`:[ptr i8] - Pointer to the first value, string, or memory region.
- `b`:[ptr i8] - Pointer to the second value, string, or memory region.
- `n`:[u64] - Maximum number of bytes or characters to process.

Returns a value less than, equal to, or greater than zero according to lexical ordering:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_strncmp")] @[abi] extern function strncmp(ptr i8 a, ptr i8 b, u64 n) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strncmp(ptr i8 a, ptr i8 b, u64 n) -> i32;
#endif

:/ Finds the first occurrence of a character in a byte string.
- `s`:[ptr i8] - Null-terminated byte string to search.
- `c`:[i32] - Character value to locate.

Returns a pointer to the first matching character, or a null pointer:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strchr")] @[abi] extern function strchr(ptr i8 s, i32 c) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strchr(ptr i8 s, i32 c) -> ptr i8;
#endif

:/ Finds the last occurrence of a character in a byte string.
- `s`:[ptr i8] - Null-terminated byte string to search.
- `c`:[i32] - Character value to locate.

Returns a pointer to the last matching character, or a null pointer:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strrchr")] @[abi] extern function strrchr(ptr i8 s, i32 c) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strrchr(ptr i8 s, i32 c) -> ptr i8;
#endif

:/ Finds the first occurrence of a substring.
- `haystack`:[ptr i8] - Null-terminated string to search.
- `needle`:[ptr i8] - Null-terminated substring to find.

Returns a pointer to the first matching substring, or a null pointer:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strstr")] @[abi] extern function strstr(ptr i8 haystack, ptr i8 needle) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strstr(ptr i8 haystack, ptr i8 needle) -> ptr i8;
#endif

:/ Finds the first character in a string that belongs to a specified set.
- `s`:[ptr i8] - Null-terminated byte string to search.
- `accept`:[ptr i8] - Null-terminated set of accepted characters.

Returns a pointer to the first accepted character, or a null pointer:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strpbrk")] @[abi] extern function strpbrk(ptr i8 s, ptr i8 accept) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strpbrk(ptr i8 s, ptr i8 accept) -> ptr i8;
#endif

:/ Returns the length of the initial segment containing only accepted characters.
- `s`:[ptr i8] - Null-terminated byte string to inspect.
- `accept`:[ptr i8] - Null-terminated set of accepted characters.

Returns the length of the accepted initial segment:[u64]
/:
#ifdef CCPL_MACHO64
@[vname("_strspn")] @[abi] extern function strspn(ptr i8 s, ptr i8 accept) -> u64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strspn(ptr i8 s, ptr i8 accept) -> u64;
#endif

:/ Returns the length of the initial segment containing no rejected characters.
- `s`:[ptr i8] - Null-terminated byte string to inspect.
- `reject`:[ptr i8] - Null-terminated set of rejected characters.

Returns the length of the non-rejected initial segment:[u64]
/:
#ifdef CCPL_MACHO64
@[vname("_strcspn")] @[abi] extern function strcspn(ptr i8 s, ptr i8 reject) -> u64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strcspn(ptr i8 s, ptr i8 reject) -> u64;
#endif

:/ Compares two strings using the active locale collation rules.
- `a`:[ptr i8] - Pointer to the first value, string, or memory region.
- `b`:[ptr i8] - Pointer to the second value, string, or memory region.

Returns a value less than, equal to, or greater than zero according to locale collation:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_strcoll")] @[abi] extern function strcoll(ptr i8 a, ptr i8 b) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strcoll(ptr i8 a, ptr i8 b) -> i32;
#endif

:/ Transforms a string into a form suitable for locale-aware comparison.
- `dst`:[ptr i8] - Pointer to the destination memory region or string.
- `src`:[ptr i8] - Pointer to the source memory region or string.
- `n`:[u64] - Capacity of the destination buffer in bytes.

Returns the length of the fully transformed string, excluding the terminator:[u64]
/:
#ifdef CCPL_MACHO64
@[vname("_strxfrm")] @[abi] extern function strxfrm(ptr i8 dst, ptr i8 src, u64 n) -> u64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strxfrm(ptr i8 dst, ptr i8 src, u64 n) -> u64;
#endif

:/ Splits a string into tokens using delimiter characters.
- `s`:[ptr i8] - String to tokenize, or a null pointer to continue the previous tokenization.
- `delim`:[ptr i8] - Null-terminated set of token delimiter characters.

Returns a pointer to the next token, or a null pointer when no token remains:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strtok")] @[abi] extern function strtok(ptr i8 s, ptr i8 delim) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strtok(ptr i8 s, ptr i8 delim) -> ptr i8;
#endif

:/ Splits a string into tokens using caller-managed state.
- `s`:[ptr i8] - String to tokenize, or a null pointer to continue using the supplied state.
- `delim`:[ptr i8] - Null-terminated set of token delimiter characters.
- `state`:[ptr ptr i8] - Caller-managed tokenizer state.

Returns a pointer to the next token, or a null pointer when no token remains:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strtok_r")] @[abi] extern function strtok_r(ptr i8 s, ptr i8 delim, ptr ptr i8 state) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strtok_r(ptr i8 s, ptr i8 delim, ptr ptr i8 state) -> ptr i8;
#endif

:/ Returns a textual description of an error code.
- `errnum`:[i32] - Error number to describe.

Returns a pointer to the error-description string:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strerror")] @[abi] extern function strerror(i32 errnum) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strerror(i32 errnum) -> ptr i8;
#endif

:/ Allocates and returns a duplicate of a byte string.
- `p`:[ptr i8] - Null-terminated byte string to duplicate.

Returns a pointer to the allocated duplicate, or a null pointer on failure:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strdup")] @[abi] extern function strdup(ptr i8 p) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strdup(ptr i8 p) -> ptr i8;
#endif

:/ Allocates and returns a length-limited duplicate of a byte string.
- `p`:[ptr i8] - Byte string to duplicate.
- `n`:[u64] - Maximum number of source characters to duplicate.

Returns a pointer to the allocated duplicate, or a null pointer on failure:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_strndup")] @[abi] extern function strndup(ptr i8 p, u64 n) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function strndup(ptr i8 p, u64 n) -> ptr i8;
#endif

#ifndef CCPL_NO_CONTAINER_STRINGS
#include "stdlib_h.cpl"

:/ Owns a dynamically allocated null-terminated byte string.
- `body`:[ptr i8] - Pointer to the owned null-terminated byte sequence.
/:
container string {
    ptr i8 body;

    :/ Creates an owned string object from a null-terminated byte string.
    - `data`:[ptr i8] - Null-terminated byte string used to initialize the object.
    
    Returns a pointer to the newly allocated string object:[ptr string]
    /:
    @[vname("__string_new")]
    glob function new(ptr i8 data) -> ptr string;

    :/ Returns the length of the byte sequence owned by a string object.
    - `self`:[ptr string] - Pointer to the current string object.
    
    Returns the number of bytes before the terminating null byte:[i32]
    /:
    @[self] 
    @[vname("__string_len")]
    glob function strlen(ptr string self) -> i32;

    :/ Checks whether two strings contain equal byte sequences.
    - `self`:[ptr string] - Pointer to the current string object.
    - `other`:[ptr string] - String object or null-terminated byte string to compare.
    
    Returns one when the strings are equal, otherwise zero:[i8]
    /:
    @[self] 
    @[vname("__string_equals")]
    glob function equals(ptr string self, ptr string other) -> i8;

    :/ Releases the storage owned by a string object.
    - `self`:[ptr string] - Pointer to the current string object.
    
    Returns nothing:[i0]
    /:
    @[self] 
    @[vname("__string_destroy")]
    glob function destroy(ptr string self) -> i0;
}
#endif

#endif

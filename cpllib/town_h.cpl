#ifndef CPL_TOWN_H_
#define CPL_TOWN_H_ 0

#include "string_h.cpl"

#define OREGON_TOWN_COUNT           40
#define OREGON_TOWN_POPULATION_YEAR 2025

:/ Oregon town descriptor.
- `name`:[ptr i8] - Null-terminated town name.
- `population`:[u64] - Census PEP Vintage 2025 resident population estimate.

Town records returned by this library are global static objects. Callers must
not free them or mutate their names.
/:
container town {
    ptr i8 name;
    u64    population;

    :/ Looks up an Oregon town by exact name.
    - `name`:[ptr i8] - Null-terminated town name to search for.

    Matching is case-sensitive and uses `strcmp`.
    Returns a pointer to a global `town` record, or a null pointer when not found:[ptr town]
    /:
    @[vname("__oregon_town_find")] @[abi]
    glob function find(ptr i8 name) -> ptr town;

    :/ Checks whether an exact Oregon town name is known.
    - `name`:[ptr i8] - Null-terminated town name to search for.

    Returns one when `find(name)` succeeds, otherwise zero:[i8]
    /:
    @[vname("__oregon_town_contains")] @[abi]
    glob function contains(ptr i8 name) -> i8;

    :/ Returns the number of global Oregon town records in this library.

    Returns the fixed town count:[u64]
    /:
    @[vname("__oregon_town_count")] @[abi]
    glob function count() -> u64;
}

#endif

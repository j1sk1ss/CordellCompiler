#endif
#ifndef CCPL_MACHO64
@[abi] extern function setbuf(ptr FILE stream, ptr i8 buf) -> i0;
#endif

:/ Configures the buffering mode and buffer for a stream.
- `stream`:[ptr FILE] - Pointer to the stream.
- `buf`:[ptr i8] - Buffer to use, or a null pointer to let the runtime allocate one.
- `mode`:[i32] - Requested buffering mode.

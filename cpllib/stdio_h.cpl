@[vname("_freopen")] @[abi] extern function freopen(ptr i8 path, ptr i8 mode, ptr FILE stream) -> ptr FILE;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function freopen(ptr i8 path, ptr i8 mode, ptr FILE stream) -> ptr FILE;
#endif

:/ Configures buffering for a stream using a caller-provided buffer.

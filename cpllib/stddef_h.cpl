#ifndef CPL_STDDEF_H_
#define CPL_STDDEF_H_ 0

#include "platform_h.cpl"
#include "types_h.cpl"

#ifdef CCPL_GNUI386
#define size_t    u32
#define ssize_t   i32
#define ptrdiff_t i32
#define wchar_t   i32
#endif
#ifndef CCPL_GNUI386
#ifdef CCPL_WINDOWS64
#define size_t    u64
#define ssize_t   i64
#define ptrdiff_t i64
#define wchar_t   u16
#endif
#ifndef CCPL_WINDOWS64
#define size_t    u64
#define ssize_t   i64
#define ptrdiff_t i64
#define wchar_t   i32
#endif
#endif

#endif

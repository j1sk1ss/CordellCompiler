#ifndef CPL_UNISTD_H_
#define CPL_UNISTD_H_ 0

#include "platform_h.cpl"
#include "stddef_h.cpl"

#define STDIN_FILENO  0
#define STDOUT_FILENO 1
#define STDERR_FILENO 2

#define F_OK 0
#define X_OK 1
#define W_OK 2
#define R_OK 4

#ifndef SEEK_SET
    #define SEEK_SET 0
#endif
#ifndef SEEK_CUR
    #define SEEK_CUR 1
#endif
#ifndef SEEK_END
    #define SEEK_END 2
#endif

:/ Reads bytes from a file descriptor.
- `fd`:[i32] - Open file descriptor.
- `buf`:[ptr i0] - Pointer to the caller-provided buffer.
- `count`:[u64] - Maximum number of bytes to read.

Returns the number of bytes read, zero at end of file, or -1 on failure:[i64]
/:
#ifdef CCPL_MACHO64
@[vname("_read")] @[abi] extern function read(i32 fd, ptr i0 buf, u64 count) -> i64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function read(i32 fd, ptr i0 buf, u64 count) -> i64;
#endif

:/ Writes bytes to a file descriptor.
- `fd`:[i32] - Open file descriptor.
- `buf`:[ptr i0] - Pointer to the caller-provided buffer.
- `count`:[u64] - Number of bytes to write.

Returns the number of bytes written, or -1 on failure:[i64]
/:
#ifdef CCPL_MACHO64
@[vname("_write")] @[abi] extern function write(i32 fd, ptr i0 buf, u64 count) -> i64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function write(i32 fd, ptr i0 buf, u64 count) -> i64;
#endif

:/ Closes an open file descriptor.
- `fd`:[i32] - Open file descriptor.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_close")] @[abi] extern function close(i32 fd) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function close(i32 fd) -> i32;
#endif

:/ Moves the offset of an open file descriptor.
- `fd`:[i32] - Open file descriptor.
- `offset`:[i64] - Signed offset relative to the selected origin.
- `whence`:[i32] - Origin from which the offset is measured.

Returns the resulting file offset on success, otherwise -1:[i64]
/:
#ifdef CCPL_MACHO64
@[vname("_lseek")] @[abi] extern function lseek(i32 fd, i64 offset, i32 whence) -> i64;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function lseek(i32 fd, i64 offset, i32 whence) -> i64;
#endif

:/ Removes a directory entry for a file.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_unlink")] @[abi] extern function unlink(ptr i8 path) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function unlink(ptr i8 path) -> i32;
#endif

:/ Removes an empty directory.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_rmdir")] @[abi] extern function rmdir(ptr i8 path) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function rmdir(ptr i8 path) -> i32;
#endif

:/ Changes the process working directory.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_chdir")] @[abi] extern function chdir(ptr i8 path) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function chdir(ptr i8 path) -> i32;
#endif

:/ Retrieves the absolute path of the process working directory.
- `buf`:[ptr i8] - Pointer to the caller-provided buffer.
- `size`:[u64] - Size of one object, allocation, or buffer in bytes.

Returns the supplied buffer on success, otherwise a null pointer:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_getcwd")] @[abi] extern function getcwd(ptr i8 buf, u64 size) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function getcwd(ptr i8 buf, u64 size) -> ptr i8;
#endif

:/ Checks accessibility of a filesystem object using the real user and group IDs.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.
- `mode`:[i32] - Requested accessibility checks.

Returns zero when access is permitted, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_access")] @[abi] extern function access(ptr i8 path, i32 mode) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function access(ptr i8 path, i32 mode) -> i32;
#endif

:/ Duplicates a file descriptor.
- `old_fd`:[i32] - Existing file descriptor to duplicate.

Returns the new file descriptor on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_dup")] @[abi] extern function dup(i32 old_fd) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function dup(i32 old_fd) -> i32;
#endif

:/ Duplicates a file descriptor onto a selected descriptor number.
- `old_fd`:[i32] - Existing file descriptor to duplicate.
- `new_fd`:[i32] - Desired file descriptor number for the duplicate.

Returns the selected new file descriptor on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_dup2")] @[abi] extern function dup2(i32 old_fd, i32 new_fd) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function dup2(i32 old_fd, i32 new_fd) -> i32;
#endif

:/ Creates a unidirectional byte stream and returns its two file descriptors.
- `pipefd`:[ptr i32] - Pointer to a two-element array receiving the read and write descriptors.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_pipe")] @[abi] extern function pipe(ptr i32 pipefd) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function pipe(ptr i32 pipefd) -> i32;
#endif
#ifndef CCPL_MACHO64

:/ Creates a pipe and applies flags atomically.
- `pipefd`:[ptr i32] - Pointer to a two-element array receiving the read and write descriptors.
- `flags`:[i32] - Flags applied to both newly created descriptors.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_pipe2")] @[abi] extern function pipe2(ptr i32 pipefd, i32 flags) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function pipe2(ptr i32 pipefd, i32 flags) -> i32;
#endif
#endif

:/ Creates a child process by duplicating the calling process.

Returns zero in the child, the child process identifier in the parent, or -1 on failure:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_fork")] @[abi] extern function fork() -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function fork() -> i32;
#endif

:/ Terminates the calling process immediately.
- `status`:[i32] - Termination status made available to the parent process.

Returns nothing because the function does not return normally:[i0]
/:
#ifdef CCPL_MACHO64
@[vname("__exit")] @[abi] extern function _exit(i32 status) -> i0;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function _exit(i32 status) -> i0;
#endif

:/ Replaces the current process image with a new program and environment.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.
- `argv`:[ptr ptr i8] - Null-terminated array of argument strings.
- `envp`:[ptr ptr i8] - Null-terminated array of environment strings.

Returns -1 on failure because successful execution does not return:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_execve")] @[abi] extern function execve(ptr i8 path, ptr ptr i8 argv, ptr ptr i8 envp) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function execve(ptr i8 path, ptr ptr i8 argv, ptr ptr i8 envp) -> i32;
#endif

:/ Replaces the current process image with a new program and argument vector.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.
- `argv`:[ptr ptr i8] - Null-terminated array of argument strings.

Returns -1 on failure because successful execution does not return:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_execv")] @[abi] extern function execv(ptr i8 path, ptr ptr i8 argv) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function execv(ptr i8 path, ptr ptr i8 argv) -> i32;
#endif

:/ Replaces the current process image with a new program and variadic argument list.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.
- `arg0`:[ptr i8] - First argument passed to the new program, conventionally its name.
- `variadic_arguments`:[...] - Additional arguments required by the selected operation or format string.

Returns -1 on failure because successful execution does not return:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_execl")] @[abi] extern function execl(ptr i8 path, ptr i8 arg0, ...) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function execl(ptr i8 path, ptr i8 arg0, ...) -> i32;
#endif

:/ Returns the process identifier of the calling process.

Returns the calling process identifier:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_getpid")] @[abi] extern function getpid() -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function getpid() -> i32;
#endif

:/ Returns the parent process identifier of the calling process.

Returns the parent process identifier:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_getppid")] @[abi] extern function getppid() -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function getppid() -> i32;
#endif

:/ Returns the real user identifier of the calling process.

Returns the real user identifier:[u32]
/:
#ifdef CCPL_MACHO64
@[vname("_getuid")] @[abi] extern function getuid() -> u32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function getuid() -> u32;
#endif

:/ Returns the effective user identifier of the calling process.

Returns the effective user identifier:[u32]
/:
#ifdef CCPL_MACHO64
@[vname("_geteuid")] @[abi] extern function geteuid() -> u32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function geteuid() -> u32;
#endif

:/ Returns the real group identifier of the calling process.

Returns the real group identifier:[u32]
/:
#ifdef CCPL_MACHO64
@[vname("_getgid")] @[abi] extern function getgid() -> u32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function getgid() -> u32;
#endif

:/ Returns the effective group identifier of the calling process.

Returns the effective group identifier:[u32]
/:
#ifdef CCPL_MACHO64
@[vname("_getegid")] @[abi] extern function getegid() -> u32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function getegid() -> u32;
#endif

:/ Checks whether a file descriptor refers to a terminal.
- `fd`:[i32] - Open file descriptor.

Returns one when the descriptor refers to a terminal, otherwise zero:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_isatty")] @[abi] extern function isatty(i32 fd) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function isatty(i32 fd) -> i32;
#endif

:/ Flushes modified file data and metadata to the underlying storage device.
- `fd`:[i32] - Open file descriptor.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_fsync")] @[abi] extern function fsync(i32 fd) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function fsync(i32 fd) -> i32;
#endif

:/ Changes the length of an open file.
- `fd`:[i32] - Open file descriptor.
- `length`:[i64] - Requested file length in bytes.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_ftruncate")] @[abi] extern function ftruncate(i32 fd, i64 length) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function ftruncate(i32 fd, i64 length) -> i32;
#endif

:/ Suspends execution for a number of seconds.
- `seconds`:[u32] - Requested suspension interval in seconds.

Returns zero after the full interval, otherwise the number of unslept seconds:[u32]
/:
#ifdef CCPL_MACHO64
@[vname("_sleep")] @[abi] extern function sleep(u32 seconds) -> u32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function sleep(u32 seconds) -> u32;
#endif

:/ Suspends execution for a number of microseconds.
- `usec`:[u32] - Requested suspension interval in microseconds.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_usleep")] @[abi] extern function usleep(u32 usec) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function usleep(u32 usec) -> i32;
#endif

#endif

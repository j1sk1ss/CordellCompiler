#ifndef CPL_FCNTL_H_
#define CPL_FCNTL_H_ 0

#include "platform_h.cpl"

#ifdef CCPL_MACHO64
#define O_RDONLY    0
#define O_WRONLY    1
#define O_RDWR      2
#define O_ACCMODE   3
#define O_NONBLOCK  4
#define O_APPEND    8
#define O_CREAT     512
#define O_TRUNC     1024
#define O_EXCL      2048
#define O_NOCTTY    131072
#define O_DIRECTORY 1048576
#define O_CLOEXEC   16777216
#endif
#ifndef CCPL_MACHO64
#define O_RDONLY    0
#define O_WRONLY    1
#define O_RDWR      2
#define O_ACCMODE   3
#define O_CREAT     64
#define O_EXCL      128
#define O_NOCTTY    256
#define O_TRUNC     512
#define O_APPEND    1024
#define O_NONBLOCK  2048
#define O_DIRECTORY 65536
#define O_NOFOLLOW  131072
#define O_CLOEXEC   524288
#endif

#define F_DUPFD  0
#define F_GETFD  1
#define F_SETFD  2
#define F_GETFL  3
#define F_SETFL  4
#define FD_CLOEXEC 1

#define S_IRUSR 256
#define S_IWUSR 128
#define S_IXUSR 64
#define S_IRGRP 32
#define S_IWGRP 16
#define S_IXGRP 8
#define S_IROTH 4
#define S_IWOTH 2
#define S_IXOTH 1

:/ Opens a file or device and returns a file descriptor.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.
- `flags`:[i32] - Bit mask controlling the operation.
- `variadic_arguments`:[...] - Additional arguments required by the selected operation or format string.

Returns a non-negative file descriptor on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_open")] @[abi] extern function open(ptr i8 path, i32 flags, ...) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function open(ptr i8 path, i32 flags, ...) -> i32;
#endif

:/ Creates or truncates a file and opens it for writing.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.
- `mode`:[i32] - Creation permission bits for the new file.

Returns a non-negative file descriptor on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_creat")] @[abi] extern function creat(ptr i8 path, i32 mode) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function creat(ptr i8 path, i32 mode) -> i32;
#endif

:/ Performs a control operation on an open file descriptor.
- `fd`:[i32] - Open file descriptor to control.
- `cmd`:[i32] - Control command to execute.
- `variadic_arguments`:[...] - Additional arguments required by the selected operation or format string.

Returns a command-dependent result on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_fcntl")] @[abi] extern function fcntl(i32 fd, i32 cmd, ...) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function fcntl(i32 fd, i32 cmd, ...) -> i32;
#endif

#endif

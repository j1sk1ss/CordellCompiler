:/ Opaque audio internals. Use only through pointers returned by raylib. /:
@[like_c]
container rAudioBuffer {
    i8 _opaque;
}

@[like_c]
container rAudioProcessor {
    i8 _opaque;
}

@[like_c]
container Vector2 {
    f32 x;
    f32 y;
}

@[like_c]
container Vector3 {
    f32 x;
    f32 y;
    f32 z;
}

@[like_c]
container Vector4 {
    f32 x;
    f32 y;
    f32 z;
    f32 w;
}

@[like_c]
container Matrix {
    f32 m0;
    f32 m4;
    f32 m8;
    f32 m12;
    f32 m1;
    f32 m5;
    f32 m9;
    f32 m13;
    f32 m2;
    f32 m6;
    f32 m10;
    f32 m14;
    f32 m3;
    f32 m7;
    f32 m11;
    f32 m15;
}

:/ raylib Color is a 4-byte C value { r, g, b, a }: r | (g << 8) | (b << 16) | (a << 24). /:
#define Color u32

@[like_c]
container Rectangle {
    f32 x;
    f32 y;
    f32 width;
    f32 height;
}

@[like_c]
container Image {
    ptr i0 data;
    i32 width;
    i32 height;
    i32 mipmaps;
    i32 format;
}

@[like_c]
container Texture {
    u32 id;
    i32 width;
    i32 height;
    i32 mipmaps;
    i32 format;
}

@[like_c]
container RenderTexture {
    u32 id;
    Texture texture;
    Texture depth;
}

@[like_c]
container NPatchInfo {
    Rectangle source;
    i32 left;
    i32 top;
    i32 right;
    i32 bottom;
    i32 layout;
}

@[like_c]
container GlyphInfo {
    i32 value;
    i32 offsetX;
    i32 offsetY;
    i32 advanceX;
    Image image;
}

@[like_c]
container Font {
    i32 baseSize;
    i32 glyphCount;
    i32 glyphPadding;
    Texture2D texture;
    ptr Rectangle recs;
    ptr GlyphInfo glyphs;
}

@[like_c]
container Camera3D {
    Vector3 position;
    Vector3 target;
    Vector3 up;
    f32 fovy;
    i32 projection;
}

@[like_c]
container Camera2D {
    Vector2 offset;
    Vector2 target;
    f32 rotation;
    f32 zoom;
}

@[like_c]
container Mesh {
    i32 vertexCount;
    i32 triangleCount;
    ptr f32 vertices;
    ptr f32 texcoords;
    ptr f32 texcoords2;
    ptr f32 normals;
    ptr f32 tangents;
    ptr u8 colors;
    ptr u16 indices;
    i32 boneCount;
    ptr u8 boneIndices;
    ptr f32 boneWeights;
    ptr f32 animVertices;
    ptr f32 animNormals;
    u32 vaoId;
    ptr u32 vboId;
}

@[like_c]
container Shader {
    u32 id;
    ptr i32 locs;
}

@[like_c]
container MaterialMap {
    Texture2D texture;
    Color color;
    f32 value;
}

@[like_c]
container Material {
    Shader shader;
    ptr MaterialMap maps;
    arr params[4, f32];
}

@[like_c]
container Transform {
    Vector3 translation;
    Quaternion rotation;
    Vector3 scale;
}

@[like_c]
container BoneInfo {
    arr name[32, i8];
    i32 parent;
}

@[like_c]
container ModelSkeleton {
    i32 boneCount;
    ptr BoneInfo bones;
    ModelAnimPose bindPose;
}

@[like_c]
container Model {
    Matrix transform;
    i32 meshCount;
    i32 materialCount;
    ptr Mesh meshes;
    ptr Material materials;
    ptr i32 meshMaterial;
    ModelSkeleton skeleton;
    ModelAnimPose currentPose;
    ptr Matrix boneMatrices;
}

@[like_c]
container ModelAnimation {
    arr name[32, i8];
    i32 boneCount;
    i32 keyframeCount;
    ptr ModelAnimPose keyframePoses;
}

@[like_c]
container Ray {
    Vector3 position;
    Vector3 direction;
}

@[like_c]
container RayCollision {
    i8 hit;
    f32 distance;
    Vector3 point;
    Vector3 normal;
}

@[like_c]
container BoundingBox {
    Vector3 min;
    Vector3 max;
}

@[like_c]
container Wave {
    u32 frameCount;
    u32 sampleRate;
    u32 sampleSize;
    u32 channels;
    ptr i0 data;
}

@[like_c]
container AudioStream {
    ptr rAudioBuffer buffer;
    ptr rAudioProcessor processor;
    u32 sampleRate;
    u32 sampleSize;
    u32 channels;
}

@[like_c]
container Sound {
    AudioStream stream;
    u32 frameCount;
}

@[like_c]
container Music {
    AudioStream stream;
    u32 frameCount;
    i8 looping;
    i32 ctxType;
    ptr i0 ctxData;
}

@[like_c]
container VrDeviceInfo {
    i32 hResolution;
    i32 vResolution;
    f32 hScreenSize;
    f32 vScreenSize;
    f32 eyeToScreenDistance;
    f32 lensSeparationDistance;
    f32 interpupillaryDistance;
    arr lensDistortionValues[4, f32];
    arr chromaAbCorrection[4, f32];
}

@[like_c]
container VrStereoConfig {
    arr projection[2, Matrix];
    arr viewOffset[2, Matrix];
    arr leftLensCenter[2, f32];
    arr rightLensCenter[2, f32];
    arr leftScreenCenter[2, f32];
    arr rightScreenCenter[2, f32];
    arr scale[2, f32];
    arr scaleIn[2, f32];
}

@[like_c]
container FilePathList {
    u32 count;
    ptr ptr i8 paths;
}

@[like_c]
container AutomationEvent {
    u32 frame;
    u32 type;
    arr params[4, i32];
}

@[like_c]
container AutomationEventList {
    u32 capacity;
    u32 count;
    ptr AutomationEvent events;
}


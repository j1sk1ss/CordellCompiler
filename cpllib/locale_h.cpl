#ifndef CPL_LOCALE_H_
#define CPL_LOCALE_H_ 0

#include "platform_h.cpl"
#include "types_h.cpl"

#ifdef CCPL_MACHO64
    #define LC_ALL      0
    #define LC_COLLATE  1
    #define LC_CTYPE    2
    #define LC_MONETARY 3
    #define LC_NUMERIC  4
    #define LC_TIME     5
    #define LC_MESSAGES 6
#endif
#ifndef CCPL_MACHO64
    #define LC_CTYPE    0
    #define LC_NUMERIC  1
    #define LC_TIME     2
    #define LC_COLLATE  3
    #define LC_MONETARY 4
    #define LC_MESSAGES 5
    #define LC_ALL      6
#endif

:/ Selects or queries the program locale for a category.
- `category`:[i32] - Locale category to query or modify.
- `locale`:[ptr i8] - Locale name, an empty string for the environment default, or a null pointer to query the current setting.

Returns the active locale name on success, otherwise a null pointer:[ptr i8]
/:
#ifdef CCPL_MACHO64
@[vname("_setlocale")] @[abi] extern function setlocale(i32 category, ptr i8 locale) -> ptr i8;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function setlocale(i32 category, ptr i8 locale) -> ptr i8;
#endif

:/ Returns locale-specific numeric and monetary formatting information.

Returns a pointer to the current locale-formatting data:[ptr c_lconv]
/:
#ifdef CCPL_MACHO64
@[vname("_localeconv")] @[abi] extern function localeconv() -> ptr c_lconv;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function localeconv() -> ptr c_lconv;
#endif

#endif

#ifndef CPL_HTTP_H_
#define CPL_HTTP_H_ 0

#include "platform_h.cpl"
#include "stddef_h.cpl"
#include "stdint_h.cpl"
#include "string_h.cpl"
#include "unistd_h.cpl"
#include "fcntl_h.cpl"
#include "poll_h.cpl"
#include "signal_h.cpl"

:/ Tiny blocking HTTP/1.1 server helpers.
Handler functions are stored as `ptr i0` and must have this shape:

```
function handler(ptr http_request req, ptr http_response res) -> i0
```

The server closes each accepted connection after one response.
/:

#define HTTP_MAX_ROUTES          32
#define HTTP_MAX_STATIC_ROUTES   8
#define HTTP_REQUEST_BUFFER_SIZE 8192
#define HTTP_MAX_PATH            1024
#define HTTP_FILE_CHUNK          4096

#define HTTP_AF_INET             2
#define HTTP_SOCK_STREAM         1

#ifdef CCPL_MACHO64
    #define HTTP_SOL_SOCKET      65535
    #define HTTP_SO_REUSEADDR    4
#endif
#ifndef CCPL_MACHO64
    #define HTTP_SOL_SOCKET      1
    #define HTTP_SO_REUSEADDR    2
#endif

:/ C-compatible IPv4 socket address used by `http_server::listen`.

The layout differs on Mach-O because BSD sockets include `sin_len`. Users
normally do not need to create this container directly.
/:
@[like_c]
container http_sockaddr_in {
#ifdef CCPL_MACHO64
    u8 sin_len;
    u8 sin_family;
#endif
#ifndef CCPL_MACHO64
    u16 sin_family;
#endif
    u16 sin_port;
    u32 sin_addr;
    arr sin_zero[8, u8];
}

#ifdef CCPL_MACHO64
@[vname("_socket")] @[abi] extern function c_socket(i32 domain, i32 type, i32 protocol) -> i32;
@[vname("_bind")] @[abi] extern function c_bind(i32 fd, ptr i0 addr, i32 addr_len) -> i32;
@[vname("_listen")] @[abi] extern function c_listen(i32 fd, i32 backlog) -> i32;
@[vname("_accept")] @[abi] extern function c_accept(i32 fd, ptr i0 addr, ptr i0 addr_len) -> i32;
@[vname("_setsockopt")] @[abi] extern function c_setsockopt(i32 fd, i32 level, i32 optname, ptr i0 optval, u32 optlen) -> i32;
@[vname("_htons")] @[abi] extern function c_htons(u16 value) -> u16;
@[vname("_inet_addr")] @[abi] extern function c_inet_addr(ptr i8 cp) -> u32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function c_socket(i32 domain, i32 type, i32 protocol) -> i32;
@[abi] extern function c_bind(i32 fd, ptr i0 addr, i32 addr_len) -> i32;
@[abi] extern function c_listen(i32 fd, i32 backlog) -> i32;
@[abi] extern function c_accept(i32 fd, ptr i0 addr, ptr i0 addr_len) -> i32;
@[abi] extern function c_setsockopt(i32 fd, i32 level, i32 optname, ptr i0 optval, u32 optlen) -> i32;
@[abi] extern function c_htons(u16 value) -> u16;
@[abi] extern function c_inet_addr(ptr i8 cp) -> u32;
#endif

:/ Parsed HTTP request data.
- `method`:[ptr i8] - Request method, for example `GET` or `POST`.
- `path`:[ptr i8] - Request path without the query string.
- `query`:[ptr i8] - Query string without `?`, or a null pointer.
- `body`:[ptr i8] - Pointer to the bytes after the header terminator.
- `body_len`:[u64] - Number of body bytes currently buffered.
- `raw`:[arr] - Internal request buffer mutated in place while parsing.

All pointer fields reference `raw` and are valid only until the handler returns.
The parser handles one read of up to `HTTP_REQUEST_BUFFER_SIZE - 1` bytes.
/:
container http_request {
    ptr i8 method;
    ptr i8 path;
    ptr i8 query;
    ptr i8 body;
    u64    body_len;
    arr    raw[HTTP_REQUEST_BUFFER_SIZE, i8];
}

:/ HTTP response writer bound to one accepted client socket.
- `fd`:[i32] - Client socket descriptor.
- `status_code`:[i32] - Response status written before the first header/body.
- `headers_started`:[i8] - Internal flag set after the status line is written.
- `headers_done`:[i8] - Internal flag set after the blank header line.

Set the status before adding headers or writing the body. `header` starts the
status line automatically. `write`, `text`, `html`, `file`, and `html_file`
finish headers before body bytes are sent.
/:
container http_response {
    i32 fd;
    i32 status_code;
    i8  headers_started;
    i8  headers_done;

    :/ Initializes a response object for a client descriptor.
    - `self`:[ptr http_response] - Response object to initialize.
    - `fd`:[i32] - Accepted client socket descriptor.

    Sets status to 200 and clears header state.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_response_init")] @[abi]
    glob function init(ptr http_response self, i32 fd) -> i0;

    :/ Sets the response status code.
    - `self`:[ptr http_response] - Response object to update.
    - `code`:[i32] - HTTP status code.

    The call is ignored after headers have started.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_response_status")] @[abi]
    glob function status(ptr http_response self, i32 code) -> i0;

    :/ Writes one response header.
    - `self`:[ptr http_response] - Response object to write to.
    - `name`:[ptr i8] - Header name.
    - `value`:[ptr i8] - Header value.

    Starts the status line if needed. Ignored after `end_headers`.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_response_header")] @[abi]
    glob function header(ptr http_response self, ptr i8 name, ptr i8 value) -> i0;

    :/ Finishes the header block.
    - `self`:[ptr http_response] - Response object to write to.

    Writes the terminating blank line. Safe to call more than once.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_response_end_headers")] @[abi]
    glob function end_headers(ptr http_response self) -> i0;

    :/ Writes raw body bytes.
    - `self`:[ptr http_response] - Response object to write to.
    - `data`:[ptr i0] - Bytes to send.
    - `len`:[u64] - Number of bytes to send.

    Ends headers automatically if needed.
    Returns the result from `write`:[i64]
    /:
    @[self]
    @[vname("__http_response_write")] @[abi]
    glob function write(ptr http_response self, ptr i0 data, u64 len) -> i64;

    :/ Sends a plain-text response.
    - `self`:[ptr http_response] - Response object to write to.
    - `code`:[i32] - HTTP status code.
    - `data`:[ptr i8] - Null-terminated UTF-8 text body.

    Sets `Content-Type` to `text/plain; charset=utf-8`.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_response_text")] @[abi]
    glob function text(ptr http_response self, i32 code, ptr i8 data) -> i0;

    :/ Sends an inline HTML response.
    - `self`:[ptr http_response] - Response object to write to.
    - `code`:[i32] - HTTP status code.
    - `data`:[ptr i8] - Null-terminated HTML body.

    Sets `Content-Type` to `text/html; charset=utf-8`.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_response_html")] @[abi]
    glob function html(ptr http_response self, i32 code, ptr i8 data) -> i0;

    :/ Sends a file response.
    - `self`:[ptr http_response] - Response object to write to.
    - `path`:[ptr i8] - Null-terminated file path.
    - `content_type`:[ptr i8] - Content type to use, or null to infer.

    Sends `404 Not Found` when the file cannot be opened.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_response_file")] @[abi]
    glob function file(ptr http_response self, ptr i8 path, ptr i8 content_type) -> i0;

    :/ Sends a file as HTML.
    - `self`:[ptr http_response] - Response object to write to.
    - `path`:[ptr i8] - Null-terminated HTML file path.

    Uses `text/html; charset=utf-8` as the content type.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_response_html_file")] @[abi]
    glob function html_file(ptr http_response self, ptr i8 path) -> i0;

    :/ Sends the built-in 404 text response.
    - `self`:[ptr http_response] - Response object to write to.

    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_response_not_found")] @[abi]
    glob function not_found(ptr http_response self) -> i0;
}

:/ Exact-match route entry.
- `method`:[ptr i8] - Method string such as `GET`.
- `path`:[ptr i8] - Exact request path.
- `handler`:[ptr i0] - Function pointer with the HTTP handler signature.

Route strings are borrowed. Keep them valid while the server is running.
/:
container http_route {
    ptr i8 method;
    ptr i8 path;
    ptr i0 handler;
}

:/ Static file route entry.
- `prefix`:[ptr i8] - URL prefix, for example `/assets/`.
- `root`:[ptr i8] - Filesystem root joined with the URL suffix.

Static serving is available only for GET requests. Paths containing `..` are
rejected before file lookup.
/:
container http_static_route {
    ptr i8 prefix;
    ptr i8 root;
}

:/ Blocking HTTP server state.
- `ip`:[ptr i8] - Bind IP address. Use `0 as ptr i8` for all interfaces.
- `port`:[i32] - TCP port to bind.
- `fd`:[i32] - Listening socket descriptor, or -1 before listen.
- `backlog`:[i32] - Listen backlog. Defaults to 16.
- `running`:[i8] - Loop flag used by `listen` and `stop`.
- `route_count`:[i32] - Number of exact routes.
- `static_count`:[i32] - Number of static routes.
- `routes`:[arr] - Fixed route table with `HTTP_MAX_ROUTES` entries.
- `static_routes`:[arr] - Fixed static table with `HTTP_MAX_STATIC_ROUTES` entries.

The server handles one client at a time and closes each connection after the
handler returns. It does not implement keep-alive, TLS, chunked transfer, or
full HTTP parsing.
/:
container http_server {
    ptr i8 ip;
    i32    port;
    i32    fd;
    i32    backlog;
    i8     running;
    i32    route_count;
    i32    static_count;
    arr    routes[HTTP_MAX_ROUTES, http_route];
    arr    static_routes[HTTP_MAX_STATIC_ROUTES, http_static_route];

    :/ Initializes a server object.
    - `self`:[ptr http_server] - Server object to reset.
    - `ip`:[ptr i8] - Bind IP address.
    - `port`:[i32] - TCP port.

    Does not create the socket; call `listen` after registering routes.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_server_init")] @[abi]
    glob function init(ptr http_server self, ptr i8 ip, i32 port) -> i0;

    :/ Registers an exact method/path route.
    - `self`:[ptr http_server] - Server to modify.
    - `method`:[ptr i8] - Request method.
    - `path`:[ptr i8] - Exact request path.
    - `handler`:[ptr i0] - Handler function pointer.

    Returns one on success, or zero when input is invalid or the table is full:[i8]
    /:
    @[self]
    @[vname("__http_server_route")] @[abi]
    glob function route(ptr http_server self, ptr i8 method, ptr i8 path, ptr i0 handler) -> i8;

    :/ Registers a GET route.
    - `self`:[ptr http_server] - Server to modify.
    - `path`:[ptr i8] - Exact request path.
    - `handler`:[ptr i0] - Handler function pointer.

    Returns one on success, otherwise zero:[i8]
    /:
    @[self]
    @[vname("__http_server_get")] @[abi]
    glob function get(ptr http_server self, ptr i8 path, ptr i0 handler) -> i8;

    :/ Registers a POST route.
    - `self`:[ptr http_server] - Server to modify.
    - `path`:[ptr i8] - Exact request path.
    - `handler`:[ptr i0] - Handler function pointer.

    Returns one on success, otherwise zero:[i8]
    /:
    @[self]
    @[vname("__http_server_post")] @[abi]
    glob function post(ptr http_server self, ptr i8 path, ptr i0 handler) -> i8;

    :/ Registers a GET static file prefix.
    - `self`:[ptr http_server] - Server to modify.
    - `prefix`:[ptr i8] - URL prefix to match.
    - `root`:[ptr i8] - Filesystem directory prefix.

    The URL suffix is appended to `root` after removing leading slashes.
    Returns one on success, otherwise zero:[i8]
    /:
    @[self]
    @[vname("__http_server_static")] @[abi]
    glob function static(ptr http_server self, ptr i8 prefix, ptr i8 root) -> i8;

    :/ Starts the blocking accept loop.
    - `self`:[ptr http_server] - Initialized server.

    Returns zero after `stop`, -1 on socket failure, -2 on bind failure, or -3
    on listen failure:[i32]
    /:
    @[self]
    @[vname("__http_server_listen")] @[abi]
    glob function listen(ptr http_server self) -> i32;

    :/ Requests the accept loop to stop.
    - `self`:[ptr http_server] - Running server.

    Usually called from a handler; the current request finishes first.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_server_stop")] @[abi]
    glob function stop(ptr http_server self) -> i0;

    :/ Closes the listening socket if it is open.
    - `self`:[ptr http_server] - Server to close.

    Safe to call more than once.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__http_server_close")] @[abi]
    glob function close(ptr http_server self) -> i0;
}

#endif

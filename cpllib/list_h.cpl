#ifndef LIST_H_
#define LIST_H_ 0

#include "stdlib_h.cpl"

:/ Internal doubly linked list node.
- `elem`:[ptr i0] - Caller-owned payload pointer stored in this node.
- `n`:[ptr linked_list_block] - Next node or a null pointer.
- `p`:[ptr linked_list_block] - Previous node or a null pointer.

List operations allocate and free nodes, but never allocate, copy, or free the payload stored in `elem`.
/:
container linked_list_block {
    ptr i0                elem;
    ptr linked_list_block n;
    ptr linked_list_block p;

    :/ Allocates a detached list node for a caller-owned payload.
    - `elem`:[ptr i0] - Payload pointer to store in the node.

    Returns a detached node with null previous and next links, or a null pointer on allocation failure:[ptr linked_list_block]
    /:
    @[abi]
    function new(ptr i0 elem) -> ptr linked_list_block;
}

:/ Doubly linked list of untyped caller-owned payload pointers.
- `h`:[ptr linked_list_block] - First node or a null pointer when the list is empty.
- `t`:[ptr linked_list_block] - Last node or a null pointer when the list is empty.
- `len`:[u64] - Number of nodes currently linked into the list.

The list owns only `linked_list_block` nodes. `push_*` stores payload pointers as-is; `pop_*`, `remove`, and `clear` free nodes but leave payload lifetimes under caller control.
/:
container linked_list {
    ptr linked_list_block h;
    ptr linked_list_block t;
    u64                   len;

    :/ Allocates and initializes an empty linked list object.

    Returns a new list with null head/tail and zero length, or a null pointer on allocation failure:[ptr linked_list]
    /:
    @[vname("__linked_list_new")] @[abi]
    glob function new() -> ptr linked_list;

    :/ Initializes an already allocated linked list object as empty.
    - `self`:[ptr linked_list] - List object to reset.

    Existing nodes are not freed by this function; call `clear` first when reinitializing a non-empty list.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__linked_list_init")] @[abi]
    glob function init(ptr linked_list self) -> i0;

    :/ Appends a payload pointer to the end of the list.
    - `self`:[ptr linked_list] - List to modify.
    - `elem`:[ptr i0] - Caller-owned payload pointer to store.

    This is an alias for `push_back`. On allocation failure the list is left unchanged.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__linked_list_add")] @[abi]
    glob function add(ptr linked_list self, ptr i0 elem) -> i0;

    :/ Inserts a payload pointer at the front of the list.
    - `self`:[ptr linked_list] - List to modify.
    - `elem`:[ptr i0] - Caller-owned payload pointer to store.

    Updates both head and tail when inserting into an empty list. On allocation failure the list is left unchanged.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__linked_list_push_front")] @[abi]
    glob function push_front(ptr linked_list self, ptr i0 elem) -> i0;

    :/ Inserts a payload pointer at the back of the list.
    - `self`:[ptr linked_list] - List to modify.
    - `elem`:[ptr i0] - Caller-owned payload pointer to store.

    Updates both head and tail when inserting into an empty list. On allocation failure the list is left unchanged.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__linked_list_push_back")] @[abi]
    glob function push_back(ptr linked_list self, ptr i0 elem) -> i0;

    :/ Reads the payload pointer stored at the front of the list.
    - `self`:[ptr linked_list] - List to inspect.

    Returns the head payload pointer, or a null pointer when the list is empty:[ptr i0]
    /:
    @[self]
    @[vname("__linked_list_front")] @[abi]
    glob function front(ptr linked_list self) -> ptr i0;

    :/ Reads the payload pointer stored at the back of the list.
    - `self`:[ptr linked_list] - List to inspect.

    Returns the tail payload pointer, or a null pointer when the list is empty:[ptr i0]
    /:
    @[self]
    @[vname("__linked_list_back")] @[abi]
    glob function back(ptr linked_list self) -> ptr i0;

    :/ Removes the front node and returns its payload pointer.
    - `self`:[ptr linked_list] - List to modify.

    Frees only the removed list node. The returned payload pointer remains caller-owned.
    Returns the removed payload pointer, or a null pointer when the list is empty:[ptr i0]
    /:
    @[self]
    @[vname("__linked_list_pop_front")] @[abi]
    glob function pop_front(ptr linked_list self) -> ptr i0;

    :/ Removes the back node and returns its payload pointer.
    - `self`:[ptr linked_list] - List to modify.

    Frees only the removed list node. The returned payload pointer remains caller-owned.
    Returns the removed payload pointer, or a null pointer when the list is empty:[ptr i0]
    /:
    @[self]
    @[vname("__linked_list_pop_back")] @[abi]
    glob function pop_back(ptr linked_list self) -> ptr i0;

    :/ Unlinks and frees a specific node from the list.
    - `self`:[ptr linked_list] - List that owns the node.
    - `block`:[ptr linked_list_block] - Node currently linked into this list.

    The caller must pass a node that belongs to `self`. Passing a node from another list corrupts both lists because the operation relinks neighboring nodes directly.
    Returns the removed payload pointer, or a null pointer when `block` is null:[ptr i0]
    /:
    @[self]
    @[vname("__linked_list_remove")] @[abi]
    glob function remove(ptr linked_list self, ptr linked_list_block block) -> ptr i0;

    :/ Removes every node from the list.
    - `self`:[ptr linked_list] - List to clear.

    Frees list nodes and resets head, tail, and length. Payload pointers are not freed.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__linked_list_clear")] @[abi]
    glob function clear(ptr linked_list self) -> i0;

    :/ Clears and frees a heap-allocated list object.
    - `self`:[ptr linked_list] - List allocated by `linked_list::new`.

    Safe to call with a null pointer. Payload pointers are not freed.
    Returns nothing:[i0]
    /:
    @[self]
    @[vname("__linked_list_destroy")] @[abi]
    glob function destroy(ptr linked_list self) -> i0;

    :/ Returns the number of nodes in the list.
    - `self`:[ptr linked_list] - List to inspect.

    Returns the cached node count:[u64]
    /:
    @[self]
    @[vname("__linked_list_size")] @[abi]
    glob function size(ptr linked_list self) -> u64;

    :/ Checks whether the list contains no nodes.
    - `self`:[ptr linked_list] - List to inspect.

    Returns one when the list length is zero, otherwise zero:[i8]
    /:
    @[self]
    @[vname("__linked_list_empty")] @[abi]
    glob function empty(ptr linked_list self) -> i8;
}

#endif

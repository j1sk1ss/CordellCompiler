#ifndef CPL_SYS_STAT_H_
#define CPL_SYS_STAT_H_ 0

#include "platform_h.cpl"

#include "sys_types_h.cpl"

#define S_IFMT      61440
#define S_IFSOCK    49152
#define S_IFLNK     40960
#define S_IFREG     32768
#define S_IFBLK     24576
#define S_IFDIR     16384
#define S_IFCHR     8192
#define S_IFIFO     4096

#define S_IRWXU     448
#define S_IRUSR     256
#define S_IWUSR     128
#define S_IXUSR     64
#define S_IRWXG     56
#define S_IRGRP     32
#define S_IWGRP     16
#define S_IXGRP     8
#define S_IRWXO     7
#define S_IROTH     4
#define S_IWOTH     2
#define S_IXOTH     1

:/ Retrieves metadata for a filesystem object.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.
- `stat_buf`:[ptr i0] - Pointer to a caller-provided structure that receives metadata.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_stat")] @[abi] extern function stat(ptr i8 path, ptr i0 stat_buf) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function stat(ptr i8 path, ptr i0 stat_buf) -> i32;
#endif

:/ Retrieves metadata for an open file descriptor.
- `fd`:[i32] - Open file descriptor.
- `stat_buf`:[ptr i0] - Pointer to a caller-provided structure that receives metadata.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_fstat")] @[abi] extern function fstat(i32 fd, ptr i0 stat_buf) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function fstat(i32 fd, ptr i0 stat_buf) -> i32;
#endif

:/ Retrieves metadata for a filesystem object without following its final symbolic link.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.
- `stat_buf`:[ptr i0] - Pointer to a caller-provided structure that receives metadata.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_lstat")] @[abi] extern function lstat(ptr i8 path, ptr i0 stat_buf) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function lstat(ptr i8 path, ptr i0 stat_buf) -> i32;
#endif

:/ Changes the permission bits of a filesystem object.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.
- `mode`:[u32] - New permission bits.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_chmod")] @[abi] extern function chmod(ptr i8 path, u32 mode) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function chmod(ptr i8 path, u32 mode) -> i32;
#endif

:/ Changes the permission bits of an open file.
- `fd`:[i32] - Open file descriptor.
- `mode`:[u32] - New permission bits.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_fchmod")] @[abi] extern function fchmod(i32 fd, u32 mode) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function fchmod(i32 fd, u32 mode) -> i32;
#endif

:/ Creates a directory.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.
- `mode`:[u32] - Permission bits for the new directory, subject to the process mask.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_mkdir")] @[abi] extern function mkdir(ptr i8 path, u32 mode) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function mkdir(ptr i8 path, u32 mode) -> i32;
#endif

:/ Creates a named pipe.
- `path`:[ptr i8] - Null-terminated path to the target filesystem object.
- `mode`:[u32] - Permission bits for the new named pipe, subject to the process mask.

Returns zero on success, otherwise -1:[i32]
/:
#ifdef CCPL_MACHO64
@[vname("_mkfifo")] @[abi] extern function mkfifo(ptr i8 path, u32 mode) -> i32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function mkfifo(ptr i8 path, u32 mode) -> i32;
#endif

:/ Sets the process file-creation mode mask.
- `mask`:[u32] - New file-creation mode mask.

Returns the previous file-creation mode mask:[u32]
/:
#ifdef CCPL_MACHO64
@[vname("_umask")] @[abi] extern function umask(u32 mask) -> u32;
#endif
#ifndef CCPL_MACHO64
@[abi] extern function umask(u32 mask) -> u32;
#endif

#endif

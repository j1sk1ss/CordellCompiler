#include "http_h.cpl"

function _http_write_str(i32 fd, ptr i8 text) -> i64 {
    if not text; return 0;
    write(fd, text as ptr i0, strlen(text))
}

function _http_write_status_line(ptr http_response self) -> i0 {
    @[no_fall] @[straight]
    switch self.status_code; {
        case 200; { _http_write_str(self.fd, ref "HTTP/1.1 200 OK\r\n");                    }
        case 201; { _http_write_str(self.fd, ref "HTTP/1.1 201 Created\r\n");               }
        case 204; { _http_write_str(self.fd, ref "HTTP/1.1 204 No Content\r\n");            }
        case 301; { _http_write_str(self.fd, ref "HTTP/1.1 301 Moved Permanently\r\n");     }
        case 302; { _http_write_str(self.fd, ref "HTTP/1.1 302 Found\r\n");                 }
        case 400; { _http_write_str(self.fd, ref "HTTP/1.1 400 Bad Request\r\n");           }
        case 403; { _http_write_str(self.fd, ref "HTTP/1.1 403 Forbidden\r\n");             }
        case 404; { _http_write_str(self.fd, ref "HTTP/1.1 404 Not Found\r\n");             }
        case 405; { _http_write_str(self.fd, ref "HTTP/1.1 405 Method Not Allowed\r\n");    }
        default   { _http_write_str(self.fd, ref "HTTP/1.1 500 Internal Server Error\r\n"); }
    }
}

function _http_response_start(ptr http_response self) -> i0 {
    if self.headers_started; return;
    _http_write_status_line(self);
    _http_write_str(self.fd, ref "Connection: close\r\n");
    _http_write_str(self.fd, ref "Server: cpllib-http\r\n");
    self.headers_started = 1 as i8;
}

function _http_content_type(ptr i8 path) -> ptr i8 {
    ptr i8 dot = strrchr(path, '.' as i32);
    if not dot; return ref "application/octet-stream";

    if not strcmp(dot, ref ".html"); return ref "text/html; charset=utf-8";
    if not strcmp(dot, ref ".htm");  return ref "text/html; charset=utf-8";
    if not strcmp(dot, ref ".css");  return ref "text/css; charset=utf-8";
    if not strcmp(dot, ref ".js");   return ref "application/javascript; charset=utf-8";
    if not strcmp(dot, ref ".json"); return ref "application/json; charset=utf-8";
    if not strcmp(dot, ref ".md");   return ref "text/markdown; charset=utf-8";
    if not strcmp(dot, ref ".txt");  return ref "text/plain; charset=utf-8";
    if not strcmp(dot, ref ".svg");  return ref "image/svg+xml";
    if not strcmp(dot, ref ".png");  return ref "image/png";
    if not strcmp(dot, ref ".jpg");  return ref "image/jpeg";
    if not strcmp(dot, ref ".jpeg"); return ref "image/jpeg";
    if not strcmp(dot, ref ".gif");  return ref "image/gif";
    if not strcmp(dot, ref ".ico");  return ref "image/x-icon";

    ref "application/octet-stream"
}

function _http_streq(ptr i8 a, ptr i8 b) -> i8 {
    if not a || not b; return 0 as i8;
    (not strcmp(a, b)) as i8
}

function _http_prefix_match(ptr i8 text, ptr i8 prefix) -> i8 {
    if not text || not prefix; return 0 as i8;

    while dref prefix; {
        if not dref text; return 0 as i8;
        if dref text != dref prefix; return 0 as i8;
        text += 1 as ptr i8;
        prefix += 1 as ptr i8;
    }

    1 as i8
}

function _http_contains_dotdot(ptr i8 text) -> i8 {
    if not text; return 1 as i8;

    while dref text; {
        if dref text == '.' && dref (text + 1 as ptr i8) == '.'; return 1 as i8;
        text += 1 as ptr i8;
    }

    0 as i8
}

function _http_file_exists(ptr i8 path) -> i8 {
    i32 fd = open(path, O_RDONLY as i32);
    if fd < 0; return 0 as i8;
    close(fd);
    1 as i8
}

function _http_join_path(ptr i8 out, i32 out_len, ptr i8 root, ptr i8 suffix) -> i8 {
    if not out || out_len <= 0 || not root || not suffix; return 0 as i8;

    i32 i = 0;
    while dref root && i < out_len - 1; {
        out[i] = dref root;
        root += 1 as ptr i8;
        i += 1;
    }

    while dref suffix == '/'; suffix += 1 as ptr i8;

    while dref suffix && i < out_len - 1; {
        out[i] = dref suffix;
        suffix += 1 as ptr i8;
        i += 1;
    }

    out[i] = 0 as i8;
    1 as i8
}

function _http_wait_readable(i32 fd) -> i8 {
    c_pollfd pfd;
    pfd.fd = fd;
    pfd.events = POLLIN as i16;
    pfd.revents = 0 as i16;

    if poll(ref pfd, 1 as u64, 1000 as i32) <= 0; return 0 as i8;
    1 as i8
}

function _http_zero_sockaddr(ptr http_sockaddr_in addr) -> i0 {
    i32 i = 7;
    @[counter(i)] loop addr.sin_zero[i] = 0 as u8;
}

glob function http_response::init(ptr http_response self, i32 fd) -> i0 {
    self.fd              = fd;
    self.status_code     = 200;
    self.headers_started = 0 as i8;
    self.headers_done    = 0 as i8;
}

glob function http_response::status(ptr http_response self, i32 code) -> i0 {
    if self.headers_started; return;
    self.status_code = code;
}

glob function http_response::header(ptr http_response self, ptr i8 name, ptr i8 value) -> i0 {
    if self.headers_done || not name || not value; return;
    _http_response_start(self);
    _http_write_str(self.fd, name);
    _http_write_str(self.fd, ref ": ");
    _http_write_str(self.fd, value);
    _http_write_str(self.fd, ref "\r\n");
}

glob function http_response::end_headers(ptr http_response self) -> i0 {
    if self.headers_done; return;
    _http_response_start(self);
    _http_write_str(self.fd, ref "\r\n");
    self.headers_done = 1 as i8;
}

glob function http_response::write(ptr http_response self, ptr i0 data, u64 len) -> i64 {
    if not data || not len; return 0;
    if not self.headers_done; self.end_headers();
    write(self.fd, data, len)
}

glob function http_response::text(ptr http_response self, i32 code, ptr i8 data) -> i0 {
    self.status(code);
    self.header(ref "Content-Type", ref "text/plain; charset=utf-8");
    self.end_headers();
    self.write(data as ptr i0, strlen(data));
}

glob function http_response::html(ptr http_response self, i32 code, ptr i8 data) -> i0 {
    self.status(code);
    self.header(ref "Content-Type", ref "text/html; charset=utf-8");
    self.end_headers();
    self.write(data as ptr i0, strlen(data));
}

glob function http_response::file(ptr http_response self, ptr i8 path, ptr i8 content_type) -> i0 {
    if not path; {
        self.not_found();
        return;
    }

    i32 file_fd = open(path, O_RDONLY as i32);
    if file_fd < 0; {
        self.not_found();
        return;
    }

    self.status(200 as i32);
    if content_type; self.header(ref "Content-Type", content_type);
    else self.header(ref "Content-Type", _http_content_type(path));
    self.end_headers();

    arr buffer[HTTP_FILE_CHUNK, i8];
    i64 n = read(file_fd, (ref buffer) as ptr i0, HTTP_FILE_CHUNK as u64);
    while n > 0; {
        self.write((ref buffer) as ptr i0, n as u64);
        n = read(file_fd, (ref buffer) as ptr i0, HTTP_FILE_CHUNK as u64);
    }

    close(file_fd);
}

glob function http_response::html_file(ptr http_response self, ptr i8 path) -> i0 {
    self.file(path, ref "text/html; charset=utf-8");
}

glob function http_response::not_found(ptr http_response self) -> i0 {
    self.text(404 as i32, ref "404 Not Found\n");
}

glob function http_server::init(ptr http_server self, ptr i8 ip, i32 port) -> i0 {
    self.ip           = ip;
    self.port         = port;
    self.fd           = -1;
    self.backlog      = 16;
    self.running      = 0 as i8;
    self.route_count  = 0;
    self.static_count = 0;
}

glob function http_server::route(ptr http_server self, ptr i8 method, ptr i8 path, ptr i0 handler) -> i8 {
    if not method || not path || not handler; return 0 as i8;
    if self.route_count >= HTTP_MAX_ROUTES;   return 0 as i8;
    self.routes[self.route_count].method  = method;
    self.routes[self.route_count].path    = path;
    self.routes[self.route_count].handler = handler;
    self.route_count += 1;
    1 as i8
}

glob function http_server::get(ptr http_server self, ptr i8 path, ptr i0 handler) -> i8 {
    self.route(ref "GET", path, handler)
}

glob function http_server::post(ptr http_server self, ptr i8 path, ptr i0 handler) -> i8 {
    self.route(ref "POST", path, handler)
}

glob function http_server::static(ptr http_server self, ptr i8 prefix, ptr i8 root) -> i8 {
    if not prefix || not root; return 0 as i8;
    if self.static_count >= HTTP_MAX_STATIC_ROUTES; return 0 as i8;
    self.static_routes[self.static_count].prefix = prefix;
    self.static_routes[self.static_count].root   = root;
    self.static_count += 1;
    1 as i8
}

function _http_parse_request(i32 client_fd, ptr http_request req) -> i8 {
    req.method   = 0 as ptr i8;
    req.path     = 0 as ptr i8;
    req.query    = 0 as ptr i8;
    req.body     = 0 as ptr i8;
    req.body_len = 0;

    if not _http_wait_readable(client_fd); return 0 as i8;

    i32 n = read(client_fd, req.raw as ptr i0, (HTTP_REQUEST_BUFFER_SIZE - 1) as u64) as i32;
    if n <= 0; return 0 as i8;
    req.raw[n] = 0 as i8;

    i32 i = 0;
    req.method = req.raw;
    while i < n && req.raw[i] != ' '; i += 1;
    if i >= n; return 0 as i8;
    req.raw[i] = 0 as i8;
    i += 1;

    req.path = req.raw + i as ptr i8;
    while i < n && req.raw[i] != ' '; {
        if req.raw[i] == '?' && not req.query; {
            req.raw[i] = 0 as i8;
            req.query = req.raw + (i + 1) as ptr i8;
        }
        i += 1;
    }
    if i >= n; return 0 as i8;
    req.raw[i] = 0 as i8;

    i = 0;
    while i + 3 < n; {
        if req.raw[i] == 13 as i8 && req.raw[i + 1] == 10 as i8 && req.raw[i + 2] == 13 as i8 && req.raw[i + 3] == 10 as i8; {
            req.body = req.raw + (i + 4) as ptr i8;
            req.body_len = (n - i - 4) as u64;
            return 1 as i8;
        }
        i += 1;
    }

    1 as i8
}

function _http_dispatch(ptr http_server self, ptr http_request req, ptr http_response res) -> i8 {
    i32 i = 0;
    while i < self.route_count; {
        if
            _http_streq(req.method, self.routes[i].method) &&
            _http_streq(req.path, self.routes[i].path);
        {
            self.routes[i].handler(req, res);
            return 1 as i8;
        }
        i += 1;
    }

    if not _http_streq(req.method, ref "GET"); return 0 as i8;

    i = 0;
    while i < self.static_count; {
        if _http_prefix_match(req.path, self.static_routes[i].prefix); {
            ptr i8 suffix = req.path + strlen(self.static_routes[i].prefix) as ptr i8;
            if _http_contains_dotdot(suffix); return 0 as i8;

            arr path[HTTP_MAX_PATH, i8];
            if not _http_join_path(ref path, HTTP_MAX_PATH as i32, self.static_routes[i].root, suffix); return 0 as i8;
            if _http_file_exists(ref path); {
                res.file(ref path, _http_content_type(ref path));
                return 1 as i8;
            }
        }
        i += 1;
    }

    0 as i8
}

function _http_serve_client(ptr http_server self, i32 client_fd) -> i0 {
    http_request req;
    http_response res;
    res.init(client_fd);

    if not _http_parse_request(client_fd, ref req); {
        return;
    }

    if not _http_dispatch(self, ref req, ref res); res.not_found();
}

glob function http_server::listen(ptr http_server self) -> i32 {
    http_sockaddr_in addr;
    _http_zero_sockaddr(ref addr);
    signal(SIGPIPE as i32, SIG_IGN as ptr i0);

#ifdef CCPL_MACHO64
    addr.sin_len = sizeof(http_sockaddr_in) as u8;
    addr.sin_family = HTTP_AF_INET as u8;
#endif
#ifndef CCPL_MACHO64
    addr.sin_family = HTTP_AF_INET as u16;
#endif
    addr.sin_port = c_htons(self.port as u16);
    if self.ip; addr.sin_addr = c_inet_addr(self.ip);
    else addr.sin_addr = 0 as u32;

    self.fd = c_socket(HTTP_AF_INET as i32, HTTP_SOCK_STREAM as i32, 0 as i32);
    if self.fd < 0; return -1;

    i32 opt = 1;
    c_setsockopt(self.fd, HTTP_SOL_SOCKET as i32, HTTP_SO_REUSEADDR as i32, (ref opt) as ptr i0, sizeof(i32) as u32);

    if c_bind(self.fd, (ref addr) as ptr i0, sizeof(http_sockaddr_in) as i32) < 0; {
        self.close();
        return -2;
    }

    if c_listen(self.fd, self.backlog) < 0; {
        self.close();
        return -3;
    }

    self.running = 1 as i8;
    while self.running; {
        i32 client_fd = c_accept(self.fd, 0 as ptr i0, 0 as ptr i0);
        if client_fd >= 0; {
            _http_serve_client(self, client_fd);
            close(client_fd);
        }
    }

    self.close();
    0
}

glob function http_server::stop(ptr http_server self) -> i0 {
    self.running = 0 as i8;
}

glob function http_server::close(ptr http_server self) -> i0 {
    if self.fd >= 0; {
        close(self.fd);
        self.fd = -1;
    }
}

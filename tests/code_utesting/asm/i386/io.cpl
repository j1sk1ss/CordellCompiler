@[nosection] 
@[naked]
glob function i386_panic() -> i0 {
    asm() { "cli", "hlt" }
}

@[nosection] glob function i386_enable_interrupts() -> i0 {
    asm() { "sti" }
}

@[nosection] glob function i386_disable_interrupts() -> i0 {
    asm() { "cli" }
}


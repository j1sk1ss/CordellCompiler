: BLOCK_TEST :
: RUN_ASM[args="0"|args="1"|args="2"|args="3"|args="4"|args="5"|args="6"] :

:/ A compact table above 2^32 must reject a low value with identical low bits. /:
start(i32 argc, ptr ptr i8 argv) {
    i64 digit = (argv[1][0] as i64) - 48;
    i64 value = 4294967295 + digit;
    if digit == 6; { value = 1; }
    @[jtable] @[no_fall]
    switch value; {
        case 4294967298; exit 33;
        case 4294967296; exit 11;
        case 4294967299; exit 44;
        case 4294967297; exit 22;
        default exit 99;
    }
}

:/ OUTPUT
@case_index=0
@exit_code=99
---
@case_index=1
@exit_code=11
---
@case_index=2
@exit_code=22
---
@case_index=3
@exit_code=33
---
@case_index=4
@exit_code=44
---
@case_index=5
@exit_code=99
---
@case_index=6
@exit_code=99
---
/:

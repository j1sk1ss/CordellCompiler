: BLOCK_TEST :
: RUN_ASM :

start() {
    i32 three = 3;
    i32 seven = 7;
    i32 eleven = 11;
    i32 answer = 42;
    arr values[3, f32];
    values[0] = three as f32;
    values[1] = seven as f32;
    values[2] = eleven as f32;
    values[1] = answer as f32;
    if (values[0] as i32) != 3; { exit 1; }
    if (values[1] as i32) != 42; { exit 2; }
    if (values[2] as i32) != 11; { exit 3; }
    exit 42;
}

:/ OUTPUT
@exit_code=42
/:

: ASM_ARCH=x86_64_nasm_gnu,x86_64_nasm_macho :
: BLOCK_TEST :
: RUN_ASM[args="0"|args="1"|args="2"|args="3"|args="4"] :

:/ Runtime counts exercise CL constraints while the count and other values stay live. /:
@[inline(never)]
function check448(u64 value, i32 shift, u64 expected, u64 guard) -> i32 {
    u64 left = value << shift;
    u64 right = left >> shift;
    u64 top = ((1 as u64) << 63) >> shift;
    if left != expected; { return 1; }
    if right != value; { return 2; }
    if (top << shift) != ((1 as u64) << 63); { return 3; }
    if guard != 4294967313; { return 4; }
    return 42 + shift;
}

start(i32 argc, ptr ptr i8 argv) {
    arr shifts[5, i32] = { 0, 1, 31, 32, 63 };
    arr expected[5, u64] = { 1, 2, 2147483648, 4294967296, 0 };
    expected[4] = (1 as u64) << 63;
    i32 index = (argv[1][0] as i32) - 48;
    i32 result = check448(1 as u64, shifts[index], expected[index], 4294967313 as u64);
    if result != 42 + shifts[index]; { exit 5; }
    exit 42;
}


: BLOCK_TEST :
: RUN_ASM[args="0"|args="1"|args="2"|args="3"] :

:/ Record exactly which RHS calls run through nested AND/OR control-flow joins. /:
@[inline(never)]
function mark464(ptr i32 trace, i32 tag, i32 result) -> i32 {
    dref trace = (dref trace) * 10 + tag;
    return result;
}

start(i32 argc, ptr ptr i8 argv) {
    i32 digit = (argv[1][0] as i32) - 48;
    arr expected[4, i32] = { 2, 12, 2, 1 };
    i32 trace = 0;
    i32 selected = 0;
    if (((digit & 1) != 0) && mark464(ref trace, 1 as i32, digit & 2)) || mark464(ref trace, 2 as i32, 1 as i32); {
        selected = 7;
    } else {
        selected = 9;
    }
    if selected != 7; { exit 1; }
    if trace != expected[digit]; { exit 2; }
    exit 42;
}

:/ OUTPUT
@case_index=0
@exit_code=42
---
@case_index=1
@exit_code=42
---
@case_index=2
@exit_code=42
---
@case_index=3
@exit_code=42
---
/:

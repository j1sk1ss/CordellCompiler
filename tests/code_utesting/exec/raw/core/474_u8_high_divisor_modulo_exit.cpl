: ASM_ARCH=x86_64_nasm_gnu,x86_64_nasm_macho :
: BLOCK_TEST :
: RUN_ASM :

:/
Expected: 255 % 128 == 127.
The x86_64 GNU backend currently returns 255: the u8 divisor is extended with
MOVSX instead of MOVZX before unsigned DIV. With the high bit set, the divisor
becomes a huge u64, so the quotient is 0 and the remainder equals the dividend.
/:
@[inline(never)]
function calculate474(u8 value, u8 divisor) -> u8 {
    return value % divisor;
}

start() {
    u8 result = calculate474(255u8, 128u8);
    if result != 127u8; { exit 1; }
    exit 42;
}

:/ OUTPUT
@exit_code=42
/:

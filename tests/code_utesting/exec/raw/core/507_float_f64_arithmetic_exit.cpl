: BLOCK_TEST :
: RUN_ASM :

:/
Explicit i32 conditions isolate arithmetic from direct float-branch lowering (test 534).
/:

start() {
    f64 a = 6.0;
    f64 b = 2.0;
    if ((a + b != 8.0) as i32) != 0; { exit 1; }
    if ((a - b != 4.0) as i32) != 0; { exit 2; }
    if ((a * b != 12.0) as i32) != 0; { exit 3; }
    if ((a / b != 3.0) as i32) != 0; { exit 4; }
    if (((a + b) * (a - b) / b != 16.0) as i32) != 0; { exit 5; }
    exit 42;
}

:/ OUTPUT
@exit_code=42
/:

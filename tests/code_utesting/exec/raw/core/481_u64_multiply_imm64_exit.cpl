: ASM_ARCH=x86_64_nasm_gnu,x86_64_nasm_macho :
: BLOCK_TEST :
: RUN_ASM :

:/
Expected: 1 * 4294967297 == 4294967297.
The x86_64 GNU backend currently returns 1 by emitting IMUL r64, 4294967297.
This instruction form has no imm64 operand; NASM truncates the constant to imm32.
The test checks the expression itself; the reference comparison uses a separate register.
/:
@[inline(never)]
function calculate481(u64 value) -> u64 {
    return value * 4294967297u64;
}

start() {
    u64 result = calculate481(1u64);
    if result != 4294967297u64; { exit 1; }
    exit 42;
}

:/ OUTPUT
@exit_code=42
/:

: BLOCK_TEST :
: RUN_ASM[args="0"|args="1"|args="5"] :

:/ The same function receives aliased and distinct pointers; a load is not invariant. /:
@[inline(never)]
function accumulate456(ptr i32 read_from, ptr i32 write_to, i32 count) -> i32 {
    i32 total = 0;
    i32 index = 0;
    while index < count; {
        total += dref read_from;
        dref write_to += 3;
        index += 1;
    }
    return total;
}

start(i32 argc, ptr ptr i8 argv) {
    i32 count = (argv[1][0] as i32) - 48;
    i32 same = 10;
    i32 separate_read = 10;
    i32 separate_write = 20;
    i32 aliased = accumulate456(ref same, ref same, count);
    i32 distinct = accumulate456(ref separate_read, ref separate_write, count);
    if aliased != 10 * count + 3 * count * (count - 1) / 2; { exit 1; }
    if distinct != 10 * count; { exit 2; }
    if same != 10 + 3 * count; { exit 3; }
    if separate_read != 10; { exit 4; }
    if separate_write != 20 + 3 * count; { exit 5; }
    exit 42;
}


: ASM_ARCH=x86_64_nasm_macho,x86_64_nasm_gnu,i386_nasm_gnu :
#include "raw_syscall.inc"
: RUN_ASM :

function putc426(i8 c) -> i0 { syscall(RAW_SYS_WRITE, 1, ref c, 1); }

function run426(i32 flag) -> i0 {
    defer putc426('T');
    defer putc426('F');
    if flag; {
        putc426('A');
    } else {
        putc426('B');
    }
}

start() {
    run426(1i32);
    run426(0i32);
    exit 0;
}

:/ OUTPUT
ATFBTF
/:

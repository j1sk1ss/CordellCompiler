: BLOCK_TEST :
: RUN_ASM[args="1"|args="2"|args="3"|args="4"] :

start(i32 argc, ptr ptr i8 argv) {
    i32 value = (argv[1][0] as i32) - 48;
    i32 result = 0i32;

    @[jtable] @[no_fall]
    switch value; {
        @[fall] case 1; { result += 1; }
        case 2; { result += 2; }
        case 3; { result += 4; }
        default { result += 8; }
    }

    exit result as u8;
}

:/ OUTPUT
@case_index=0
@exit_code=3
---
@case_index=1
@exit_code=2
---
@case_index=2
@exit_code=4
---
@case_index=3
@exit_code=8
---
/:

: BLOCK_TEST :
: RUN_ASM[args="0"|args="1"] :

:/ Narrow signed and unsigned arguments straddle register and stack slots. /:
@[abi] @[inline(never)]
function check450(u8 a, i8 b, u16 c, i16 d, u32 e, i32 f, i8 g, u16 h, u8 i, i16 j, i32 digit) -> i32 {
    if (a as u64) != 255; { return 1; }
    if (b as i64) != -128; { return 2; }
    if (c as u64) != 65535; { return 3; }
    if (d as i64) != -32768; { return 4; }
    if (e as u64) != 2147483648; { return 5; }
    if (f as i64) != -2147483647; { return 6; }
    if (g as i64) != -127; { return 7; }
    if (h as u64) != 65534; { return 8; }
    if (i as u64) != 254; { return 9; }
    if (j as i32) != -32767 + digit; { return 10; }
    return 42;
}

start(i32 argc, ptr ptr i8 argv) {
    i32 digit = (argv[1][0] as i32) - 48;
    exit check450(255 as u8, -128 as i8, 65535 as u16, -32768 as i16,
        2147483648 as u32, -2147483647 as i32, -127 as i8, 65534 as u16,
        254 as u8, (-32767 + digit) as i16, digit) as u8;
}

:/ OUTPUT
@case_index=0
@exit_code=42

container reader502 {
    @[self] @[inline(never)]
    function read<T>(ptr reader502 self, ptr T value) -> T { 
        return dref value; 
    }
}

start() {
    reader502 item;
    i8 value = -128;
    if (item.read<i8>(ref value) as i64) != -128i64; exit 1;
    exit 42;
}


: BLOCK_TEST :
: RUN_ASM[args="0"|args="1"|args="3"] :

:/ Hoisting the division before a zero-trip loop would introduce division by zero. /:
@[inline(never)]
function sum457(i32 count) -> i32 {
    i32 total = 0;
    i32 index = 0;
    while index < count; {
        total += 84 / count;
        index += 1;
    }
    return total;
}

start(i32 argc, ptr ptr i8 argv) {
    i32 count = (argv[1][0] as i32) - 48;
    i32 expected = 84;
    if count == 0; { expected = 0; }
    if sum457(count) != expected; { exit 1; }
    exit 42;
}


: BLOCK_TEST :
: RUN_ASM[args="hi"|args="world"|args="cpl"] :

function strlen(ptr i8 s) -> i64 {
    i64 n = 0;
    while dref s; {
        n += 1;
        s += 1;
    }

    return n;
}

start(i64 argc, ptr ptr i8 argv) {
    exit strlen(argv[1]) as u8;
}


: ASM_ARCH=x86_64_nasm_gnu,x86_64_nasm_macho :
: BLOCK_TEST :
: RUN_ASM :

:/
Expected: 128 / 128 == 1.
The x86_64 GNU backend currently returns 0: the u8 divisor is extended with
MOVSX instead of MOVZX before unsigned DIV. With the high bit set, the divisor
becomes a huge u64, so the quotient is 0 and the remainder equals the dividend.
/:
@[inline(never)]
function calculate472(u8 value, u8 divisor) -> u8 {
    return value / divisor;
}

start() {
    u8 result = calculate472(128u8, 128u8);
    if result != 1u8; { exit 1; }
    exit 42;
}

:/ OUTPUT
@exit_code=42
/:

: BLOCK_TEST :
: RUN_ASM :

start() {
    i32 n = 31;
    i32 d = 4;
    i32 z = 0;
    f32 numerator = n;
    f32 denominator = d;
    f32 zero = z;
    f32 positive = numerator / denominator;
    f32 negative = zero - positive;
    if (positive as i32) != 7; { exit 1; }
    if (negative as i32) != (0 - 7); { exit 2; }
    exit 42;
}

:/ OUTPUT
@exit_code=42

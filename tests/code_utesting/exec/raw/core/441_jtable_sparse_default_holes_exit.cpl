: BLOCK_TEST :
: RUN_ASM[args="1"|args="2"|args="3"|args="4"|args="5"|args="6"|args="7"] :

start(i32 argc, ptr ptr i8 argv) {
    i32 value = (argv[1][0] as i32) - 48;

    @[jtable] @[no_fall]
    switch value; {
        case 1; exit 11;
        case 4; exit 44;
        case 7; exit 77;
        default exit 99;
    }
}


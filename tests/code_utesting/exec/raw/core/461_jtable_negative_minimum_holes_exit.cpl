: BLOCK_TEST :
: RUN_ASM[args="0"|args="1"|args="2"|args="3"|args="4"|args="5"|args="6"|args="7"] :

:/ Normalize a negative minimum; cover both bounds, zero and interior holes. /:
start(i32 argc, ptr ptr i8 argv) {
    i32 value = (argv[1][0] as i32) - 52;
    @[jtable] @[no_fall]
    switch value; {
        case 2; exit 23;
        case -3; exit 13;
        case 0; exit 19;
        case -1; exit 17;
        default exit 99;
    }
}

:/ OUTPUT
@case_index=0
@exit_code=99

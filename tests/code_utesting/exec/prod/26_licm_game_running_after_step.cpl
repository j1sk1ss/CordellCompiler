: ASM_ARCH=x86_64_nasm_gnu :
: RUN_ASM :

container game26 {
    i8 running;
    i8 has_key;
    i8 won;

    @[self] @[inline(never)]
    function step(ptr game26 self, i32 input) -> i0;
}

function game26::step(ptr game26 self, i32 input) -> i0 {
    if input == 'q'; {
        self.running = 0;
        return;
    }

    if input == 'a'; {
        if self.has_key; {
            self.won = 1;
            self.running = 0;
        }
    }
}

start() {
    game26 quit;
    quit.running = 1;
    quit.has_key = 0;
    quit.won = 0;
    i32 quit_steps = 0;

    while quit.running; {
        quit.step('q' as i32);
        quit_steps += 1;
        if quit_steps > 1; exit 1;
    }

    if quit_steps != 1; exit 2;
    if quit.won; exit 3;

    game26 escape;
    escape.running = 1;
    escape.has_key = 1;
    escape.won = 0;
    i32 escape_steps = 0;

    while escape.running; {
        escape.step('a' as i32);
        escape_steps += 1;
        if escape_steps > 1; exit 4;
    }

    if escape_steps != 1; exit 5;
    if not escape.won; exit 6;
    exit 0;
}

:/ OUTPUT
@measure_time
@measure_lines
@repeat=5
@exit_code=0
/:

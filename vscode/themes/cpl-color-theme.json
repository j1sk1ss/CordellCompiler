{
  "name": "CPL Theme",
  "type": "dark",
  "colors": {},
  "semanticHighlighting": false,
  "tokenColors": [
    {
      "scope": [
        "keyword.control.cpl"
      ],
      "settings": {
        "foreground": "#FF00FF"
      }
    },
    {
      "scope": [
        "keyword.declaration.cpl",
        "keyword.declaration.function.cpl"
      ],
      "settings": {
        "foreground": "#FF00FF"
      }
    },
    {
      "scope": [
        "entity.name.function.cpl",
        "entity.name.function.call.cpl"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    },
    {
      "scope": [
        "storage.type.cpl"
      ],
      "settings": {
        "foreground": "#00BFFF"
      }
    },
    {
      "scope": [
        "storage.type.primitive.cpl",
        "source.cpl storage.type.primitive",
        "storage.type",
        "storage.type.user.cpl",
        "entity.name.type.container.cpl",
        "meta.array.element-type.cpl storage.type.user.cpl"
      ],
      "settings": {
        "foreground": "#4fbf4f"
      }
    },
    {
      "scope": [
        "storage.type.generic.cpl",
        "entity.name.type.parameter.cpl"
      ],
      "settings": {
        "foreground": "#4fbf4f"
      }
    },
    {
      "scope": [
        "punctuation.definition.generic.begin.cpl",
        "punctuation.definition.generic.end.cpl",
        "punctuation.separator.generic.cpl"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    }
  ]
}

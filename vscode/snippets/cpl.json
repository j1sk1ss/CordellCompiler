{
  "function-definition": {
    "scope": "cpl",
    "prefix": "function",
    "body": [
      "function ${1:name}(${2:})${3: -> ${4:i32}} {",
      "\t${0:return 0;}",
      "}"
    ],
    "description": "Function definition (return type optional)"
  },
  "function-prototype": {
    "scope": "cpl",
    "prefix": "fproto",
    "body": [
      "function ${1:name}(${2:})${3: -> ${4:i32}};"
    ],
    "description": "Function prototype (return type optional)"
  },
  "container-definition": {
    "scope": "cpl",
    "prefix": "container",
    "body": [
      "container ${1:name} {",
      "\t${2:u32 field = 0;}",
      "",
      "\t@[self]",
      "\tfunction ${3:method}(ptr ${1:name} self${4})${5: -> ${6:i0}} {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Struct-like container with annotated self method"
  },
  "container-method": {
    "scope": "cpl",
    "prefix": "cmethod",
    "body": [
      "@[self]",
      "function ${1:name}(ptr ${2:Container} self${3})${4: -> ${5:i0}} {",
      "\t${0}",
      "}"
    ],
    "description": "Container method with explicit @[self] receiver"
  },
  "container-field-access": {
    "scope": "cpl",
    "prefix": "field",
    "body": "${1:self}.${0:field}",
    "description": "Container field access"
  },
  "CPL Keywords Container": {
    "scope": "cpl",
    "prefix": "container",
    "body": "container",
    "description": "CPL keyword"
  },
  "import-op": {
    "scope": "cpl",
    "prefix": "from",
    "body": [
      "from \"${1:module}\" import ${0:name}"
    ],
    "description": "Import statement"
  },
  "extern-function": {
    "scope": "cpl",
    "prefix": "externfn",
    "body": [
      "extern function ${1:name}(${2:})${3: -> ${4:i32}};"
    ],
    "description": "Extern function prototype"
  },
  "extern-var": {
    "scope": "cpl",
    "prefix": "externvar",
    "body": [
      "extern ${1:i32} ${0:name}"
    ],
    "description": "Extern variable prototype"
  },
  "section-block": {
    "scope": "cpl",
    "prefix": "section",
    "body": [
      "section(\"${1:.text}\") {",
      "\t${0}",
      "}"
    ],
    "description": "Top-level section block"
  },
  "align-declaration": {
    "scope": "cpl",
    "prefix": "align",
    "body": [
      "align(${1:16}) ${2:i32 ${3:name}${4: = ${5:0}};}"
    ],
    "description": "Aligned declaration"
  },
  "align-block": {
    "scope": "cpl",
    "prefix": "alignblock",
    "body": [
      "align(${1:16}) {",
      "\t${0:i32 x = 0;}",
      "}"
    ],
    "description": "Aligned declaration block"
  },
  "poparg-assignment": {
    "scope": "cpl",
    "prefix": "popargvar",
    "body": [
      "${1:i32} ${2:name} = poparg;"
    ],
    "description": "Assign poparg to local variable"
  },
  "CPL Ops POPARG": {
    "scope": "cpl",
    "prefix": "poparg",
    "body": "poparg",
    "description": "CPL poparg expression"
  },
  "CPL Ops NEG": {
    "scope": "cpl",
    "prefix": "neg",
    "body": "neg ${1:x}",
    "description": "CPL bitwise inversion expression"
  },
  "CPL Ops SIZEOF": {
    "scope": "cpl",
    "prefix": "sizeof",
    "body": [
      "sizeof(${1:i32})"
    ],
    "description": "CPL sizeof expression"
  },
  "CPL Types void": {
    "scope": "cpl",
    "prefix": "i0",
    "body": "i0",
    "description": "CPL i0 type"
  },
  "CPL Keywords Section": {
    "scope": "cpl",
    "prefix": "section",
    "body": "section",
    "description": "CPL keyword"
  },
  "CPL Keywords Align": {
    "scope": "cpl",
    "prefix": "align",
    "body": "align",
    "description": "CPL keyword"
  },
  "annotation-generic": {
    "scope": "cpl",
    "prefix": "ann",
    "body": [
      "@[$1]"
    ],
    "description": "Generic annotation"
  },
  "annotation-generic-arg": {
    "scope": "cpl",
    "prefix": "annarg",
    "body": [
      "@[$1($2)]"
    ],
    "description": "Generic annotation with arguments"
  },
  "annotation-entry": {
    "scope": "cpl",
    "prefix": "entryann",
    "body": [
      "@[entry]"
    ],
    "description": "Entry point annotation"
  },
  "annotation-naked": {
    "scope": "cpl",
    "prefix": "nakedann",
    "body": [
      "@[naked]"
    ],
    "description": "Naked function annotation"
  },
  "annotation-align": {
    "scope": "cpl",
    "prefix": "alignann",
    "body": [
      "@[align(${1:16})]"
    ],
    "description": "Align annotation"
  },
  "annotation-section": {
    "scope": "cpl",
    "prefix": "sectionann",
    "body": [
      "@[section(\"${1:.text}\")]"
    ],
    "description": "Section annotation"
  },
  "annotation-address": {
    "scope": "cpl",
    "prefix": "addressann",
    "body": [
      "@[address(${1:0x1000})]"
    ],
    "description": "Address annotation"
  },
  "annotation-counter": {
    "scope": "cpl",
    "prefix": "counterann",
    "body": [
      "@[counter(${1:10})]"
    ],
    "description": "Loop counter annotation"
  },
  "annotation-no-fall": {
    "scope": "cpl",
    "prefix": "nofallann",
    "body": [
      "@[no_fall]"
    ],
    "description": "Switch no-fallthrough annotation"
  },
  "annotation-straight": {
    "scope": "cpl",
    "prefix": "straightann",
    "body": [
      "@[straight]"
    ],
    "description": "Switch linear-search annotation"
  },
  "annotation-hot": {
    "scope": "cpl",
    "prefix": "hotann",
    "body": [
      "@[hot]"
    ],
    "description": "Hot branch annotation"
  },
  "annotation-cold": {
    "scope": "cpl",
    "prefix": "coldann",
    "body": [
      "@[cold]"
    ],
    "description": "Cold branch annotation"
  },
  "annotation-register": {
    "scope": "cpl",
    "prefix": "regann",
    "body": [
      "@[register(${1:10})]"
    ],
    "description": "Register bindings for variables annotation"
  },
  "annotation-stack": {
    "scope": "cpl",
    "prefix": "annstack",
    "body": [
      "@[$1]",
      "@[$2]"
    ],
    "description": "Two stacked annotations"
  },
  "generic-function-definition": {
    "scope": "cpl",
    "prefix": "gfunction",
    "body": [
      "function ${1:name}<${2:T}>(${2:T} ${3:a})${4: -> ${2:T}} {",
      "\t${0:return ${3:a};}",
      "}"
    ],
    "description": "Generic function definition"
  },
  "generic-function-call": {
    "scope": "cpl",
    "prefix": "gcall",
    "body": "${1:container}.${2:function}<${3:i32}>(${0})",
    "description": "Generic function or container method call"
  },
  "annotation-weak": {
    "scope": "cpl",
    "prefix": "weakann",
    "body": [
      "@[weak]"
    ],
    "description": "Weak function symbol annotation"
  },
  "annotation-self": {
    "scope": "cpl",
    "prefix": "selfann",
    "body": [
      "@[self]"
    ],
    "description": "Explicit self receiver annotation for container methods"
  },
  "annotation-union": {
    "scope": "cpl",
    "prefix": "unionann",
    "body": [
      "@[union]"
    ],
    "description": "Union-like container layout annotation"
  },
  "annotation-impl": {
    "scope": "cpl",
    "prefix": "implann",
    "body": [
      "@[impl(${1:Container})]"
    ],
    "description": "Attach top-level function implementation to a container"
  },
  "container-impl-method": {
    "scope": "cpl",
    "prefix": "implmethod",
    "body": [
      "@[impl(${1:Container})]",
      "@[self]",
      "function ${2:name}(ptr ${1:Container} self${3})${4: -> ${5:i0}} {",
      "\t${0}",
      "}"
    ],
    "description": "Top-level container method implementation with @[impl] and @[self]"
  },
  "union-container-definition": {
    "scope": "cpl",
    "prefix": "unioncontainer",
    "body": [
      "@[union]",
      "container ${1:name} {",
      "\t${2:u64 value;}",
      "\t${0}",
      "}"
    ],
    "description": "Container with union-like layout annotation"
  }
}
